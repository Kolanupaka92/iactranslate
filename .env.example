# IaCTranslate configuration
#
# AI provider selection for the classify/rightsize/network agents.
#   rule       -> deterministic rule engine (default, no key required, reproducible)
#   anthropic  -> Claude structured tool-use (requires ANTHROPIC_API_KEY)
# If set to "anthropic" but no key is present, the pipeline auto-falls back to "rule".
IACTRANSLATE_LLM_PROVIDER=rule

# Anthropic API key. Enterprise note: use a zero-retention API key/tier for
# customer infrastructure data. Data is only sent to the model on the anthropic path.
ANTHROPIC_API_KEY=

# Model used for the agent steps (classify / rightsize / network).
IACTRANSLATE_ANTHROPIC_MODEL=claude-opus-4-8

# --- Persistence (ADR 0025 / 0026) ---------------------------------------
# memory (default; lost on restart) or sqlite (project metadata + audit trail
# persist across restarts).
IACTRANSLATE_STORE=memory
IACTRANSLATE_DB_PATH=./iactranslate.db

# --- Authentication ------------------------------------------------------
# Single shared bearer token for the API (ADR 0025). Not multi-user: everyone
# with the token sees everything. Leave unset for local/CLI use.
IACTRANSLATE_API_KEY=

# Multi-tenant mode (ADR 0027): "session" enables user accounts, login, and
# per-user project isolation. Requires IACTRANSLATE_STORE=sqlite.
# Unset (default) = single-tenant, no accounts.
IACTRANSLATE_AUTH=none

# Set to 0 ONLY for local http testing — it drops the Secure flag on the
# session cookie, which would expose it in cleartext over http in production.
IACTRANSLATE_COOKIE_SECURE=1

# --- Web UI / CORS -------------------------------------------------------
# Must name real origins (not "*") when IACTRANSLATE_AUTH=session: browsers
# refuse to send credentials to a wildcard origin.
IACTRANSLATE_CORS_ORIGINS=http://localhost:3000

# --- Resource limits -----------------------------------------------------
IACTRANSLATE_MAX_UPLOAD_MB=25
IACTRANSLATE_MAX_VMS=5000
IACTRANSLATE_MAX_PROJECTS=200

# --- Rate limiting (ADR 0028) --------------------------------------------
# Read live on every request — retune a running deployment without a restart.
# 0 disables an individual limiter.
IACTRANSLATE_RATE_AUTH=10     # login/register per minute, per IP AND per email
IACTRANSLATE_RATE_WRITE=60    # upload/run/jobs/report per minute, per IP
IACTRANSLATE_RATE_READ=240    # reads per minute, per IP

# Set 1 ONLY behind a proxy you control. Any client can forge X-Forwarded-For,
# so trusting it without a proxy lets attackers bypass every limit.
IACTRANSLATE_TRUST_PROXY=0
