# Generated by IaCTranslate — security groups.
{% for sg in network.security_groups %}
resource "aws_security_group" "{{ sg.resource_name }}" {
  name        = "${var.project_name}-{{ sg.name }}"
  description = "{{ sg.description }}"
  vpc_id      = aws_vpc.main.id

{% for rule in sg.ingress %}
  ingress {
    description = "{{ rule.description }}"
    from_port   = {{ rule.from_port }}
    to_port     = {{ rule.to_port }}
    protocol    = "{{ rule.protocol }}"
    cidr_blocks = [{% for cidr in rule.cidr_blocks %}"{{ cidr }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  }

{% endfor %}
  egress {
    description = "Allow all outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.project_name}-{{ sg.name }}"
  }
}

{% endfor %}
