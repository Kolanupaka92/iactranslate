# Generated by IaCTranslate — Proxmox VMs (one per source VM), cloned from templates.
#
# Sizes come from a standard grid (targets/_onprem.py), not from the source
# allocation carried across exactly — that would reproduce the over-provisioning
# the migration exists to leave behind. Every value below is editable.
#
# Each VM is a full clone of the template id in variables.tf, with cloud-init
# assigning a static address from its VLAN's range. Windows source VMs clone
# your licensed Windows template — nothing is substituted.
{% for c in compute %}
resource "proxmox_virtual_environment_vm" "{{ c.resource_name }}" {
  name        = "{{ vm_slug[c.vm_name] }}"
  description = "Migrated from {{ c.vm_name }} ({{ c.tier.value }}, {{ c.environment.value }})"
  node_name   = var.node_name
  tags        = concat(["{{ project_slug }}", "{{ c.tier.value }}", "{{ c.environment.value }}"]{% if mandated_tags %}, local.mandated_tags{% endif %})

  clone {
    vm_id = var.{{ image_refs[c.image_key].variable }}
    full  = true
  }

  cpu {
    cores = {{ c.vcpu }}
    type  = "host"
  }

  memory {
    dedicated = {{ (c.memory_gib * 1024) | int }}
  }

  operating_system {
    type = "{{ image_refs[c.image_key].ostype }}"
  }

  agent {
    enabled = true
  }

  # Root disk. The template's disk is resized on clone.
  disk {
    datastore_id = var.datastore_id
    interface    = "scsi0"
    size         = {{ c.root_volume_gib }}
    discard      = "on"
  }
{% for size in c.extra_volumes_gib %}
  # Data disk {{ loop.index }} ({{ size }} GiB) — carried from the source VM.
  disk {
    datastore_id = var.datastore_id
    interface    = "scsi{{ loop.index }}"
    size         = {{ size }}
    discard      = "on"
  }
{% endfor %}

  network_device {
    bridge   = var.bridge
    vlan_id  = var.vlan_id_{{ subnet_of[c.vm_name] }}
    firewall = true
  }

  initialization {
    datastore_id = var.datastore_id
    ip_config {
      ipv4 {
        # Static within the VLAN's range; .10 + position in the estate.
        address = "{{ network.subnets | selectattr('resource_name', 'equalto', subnet_of[c.vm_name]) | map(attribute='cidr') | first | replace('0/24', '') }}{{ 10 + loop.index0 }}/24"
        gateway = "{{ network.subnets | selectattr('resource_name', 'equalto', subnet_of[c.vm_name]) | map(attribute='cidr') | first | replace('0/24', '') }}1"
      }
    }
  }
}

# Attach the tier's firewall security group (security.tf) to this VM.
resource "proxmox_virtual_environment_firewall_rules" "{{ c.resource_name }}" {
  node_name = var.node_name
  vm_id     = proxmox_virtual_environment_vm.{{ c.resource_name }}.vm_id

  rule {
    security_group = proxmox_virtual_environment_cluster_firewall_security_group.{{ sg_resource[c.security_group] }}.name
  }
}

{% endfor %}
