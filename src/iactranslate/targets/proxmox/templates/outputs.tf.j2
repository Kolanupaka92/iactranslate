# Generated by IaCTranslate — useful outputs.
output "vm_ids" {
  description = "Map of source VM name to Proxmox VM id."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = proxmox_virtual_environment_vm.{{ c.resource_name }}.vm_id
{% endfor %}
  }
}

output "vm_ipv4" {
  description = "Map of source VM name to the static IPv4 assigned by cloud-init."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = "{{ network.subnets | selectattr('resource_name', 'equalto', subnet_of[c.vm_name]) | map(attribute='cidr') | first | replace('0/24', '') }}{{ 10 + loop.index0 }}"
{% endfor %}
  }
}
