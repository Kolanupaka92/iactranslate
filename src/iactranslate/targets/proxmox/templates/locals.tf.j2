{% if mandated_tags %}
# Generated by IaCTranslate.
# Proxmox tags are a flat list of strings on the VM. Mandated key/value tags are
# encoded as `key-value` so they survive; see compute.tf.
locals {
  mandated_tags = [
{% for key, value in mandated_tags.items() %}
    "{{ (key ~ '-' ~ value) | lower | replace(' ', '-') }}",
{% endfor %}
  ]
}
{% endif %}
