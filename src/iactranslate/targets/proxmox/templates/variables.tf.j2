# Generated by IaCTranslate.
variable "project_name" {
  description = "Project name used as a resource name prefix and tag."
  type        = string
  default     = "{{ project_slug }}"
}

variable "proxmox_endpoint" {
  description = "Proxmox VE API endpoint, e.g. https://pve.example.internal:8006/."
  type        = string
  default     = "REPLACE_ME_PROXMOX_ENDPOINT"
}

variable "proxmox_api_token" {
  description = "API token as user@realm!tokenid=secret. Set before `terraform apply`."
  type        = string
  sensitive   = true
  default     = "REPLACE_ME_API_TOKEN"
}

variable "proxmox_insecure" {
  description = "Skip TLS verification. Only for self-signed lab certificates."
  type        = bool
  default     = false
}

variable "node_name" {
  description = "Proxmox node every VM is created on. Spread across nodes by editing compute.tf, or let HA rebalance."
  type        = string
  default     = "{{ region }}"
}

variable "datastore_id" {
  description = "Datastore for VM disks (e.g. local-lvm, or a shared Ceph/NFS store for HA)."
  type        = string
  default     = "local-lvm"
}

variable "bridge" {
  description = "Linux bridge VMs attach to. VLAN tags per subnet are set on each network device."
  type        = string
  default     = "vmbr0"
}

# VLAN ids are the network team's to assign; each planned subnet becomes a
# VLAN tag on the bridge above.
{% for subnet in network.subnets %}
variable "vlan_id_{{ subnet.resource_name }}" {
  description = "VLAN tag for {{ subnet.name }} ({{ subnet.cidr }}, {{ subnet.tier.value }})."
  type        = number
  default     = {{ 100 + loop.index0 }}
}

{% endfor %}
# Templates are VMs you built once (cloud-init enabled) and converted. Set each
# to that template's numeric VM id on the node above.
{% for key in image_keys %}
variable "{{ image_refs[key].variable }}" {
  description = "VM id of the {{ key }} template to clone."
  type        = number
  default     = 9000
}

{% endfor %}
