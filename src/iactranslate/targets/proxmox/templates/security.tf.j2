# Generated by IaCTranslate — firewall security groups, one per tier.
#
# The Proxmox firewall has a named, reusable rule set — a security group —
# that attaches to a VM. That is exactly the shape the plan carries, so unlike
# Nutanix these rules are generated for real, not recorded as intent.
#
# The datacenter-level firewall must be enabled for any of this to take
# effect (Datacenter -> Firewall -> Options -> Firewall: yes). It is off by
# default on a fresh install, and a security group on a VM whose datacenter
# firewall is off is silently inert.
{% for sg in network.security_groups %}
resource "proxmox_virtual_environment_cluster_firewall_security_group" "{{ sg.resource_name }}" {
  name    = "{{ project_slug }}-{{ sg.name }}"
  comment = "{{ sg.description }}"

{% for rule in sg.ingress %}
{% for cidr in rule.cidr_blocks %}
  rule {
    type    = "in"
    action  = "ACCEPT"
    proto   = "{{ rule.protocol }}"
    dport   = "{{ rule.from_port }}{% if rule.to_port != rule.from_port %}:{{ rule.to_port }}{% endif %}"
    source  = "{{ cidr }}"
    comment = "{{ rule.description }}"
  }
{% endfor %}
{% endfor %}
}

{% endfor %}
