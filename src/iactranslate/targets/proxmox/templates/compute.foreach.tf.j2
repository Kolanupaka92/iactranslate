# Generated by IaCTranslate — Proxmox VMs, one resource over a per-VM map (the
# `for_each` layout, ADR 0073), cloned from templates.
#
# Keys are the classic layout's labels, so `proxmox_virtual_environment_vm.vm["app01"]`
# is the classic `proxmox_virtual_environment_vm.app01`. Data disks are part of
# the VM resource on Proxmox, so each row carries its disk sizes.
#
# Sizes come from a standard grid (targets/_onprem.py), not from the source
# allocation carried across exactly — that would reproduce the over-provisioning
# the migration exists to leave behind. Every value below is editable.
#
# Each VM is a full clone of the template id in variables.tf, with cloud-init
# assigning a static address from its VLAN's range. Windows source VMs clone
# your licensed Windows template — nothing is substituted.

locals {
  vms = {
{% for c in compute %}
{% set prefix = network.subnets | selectattr('resource_name', 'equalto', subnet_of[c.vm_name]) | map(attribute='cidr') | first | replace('0/24', '') %}
    "{{ c.resource_name }}" = {
      slug        = "{{ vm_slug[c.resource_name] }}"
      description = "Migrated from {{ c.vm_name }} ({{ c.tier.value }}, {{ c.environment.value }})"
      tags        = ["{{ project_slug }}", "{{ c.tier.value }}", "{{ c.environment.value }}"]
      template_id = var.{{ image_refs[c.image_key].variable }}
      cores       = {{ c.vcpu }}
      memory_mib  = {{ (c.memory_gib * 1024) | int }}
      ostype      = "{{ image_refs[c.image_key].ostype }}"
      root_gib    = {{ c.root_volume_gib }}
      data_gib    = [{{ c.extra_volumes_gib | join(", ") }}]
      vlan_id     = var.vlan_id_{{ subnet_of[c.vm_name] }}
      # Static within the VLAN's range; .10 + position in the estate.
      address     = "{{ prefix }}{{ static_host_of[c.vm_name] }}/24"
      gateway     = "{{ prefix }}1"
      sg          = proxmox_virtual_environment_cluster_firewall_security_group.{{ sg_resource[c.security_group] }}.name
    }
{% endfor %}
  }
}

resource "proxmox_virtual_environment_vm" "vm" {
  for_each = local.vms

  name        = each.value.slug
  description = each.value.description
  node_name   = var.node_name
  tags        = concat(each.value.tags{% if mandated_tags %}, local.mandated_tags{% endif %})

  clone {
    vm_id = each.value.template_id
    full  = true
  }

  cpu {
    cores = each.value.cores
    type  = "host"
  }

  memory {
    dedicated = each.value.memory_mib
  }

  operating_system {
    type = each.value.ostype
  }

  agent {
    enabled = true
  }

  # Root disk. The template's disk is resized on clone.
  disk {
    datastore_id = var.datastore_id
    interface    = "scsi0"
    size         = each.value.root_gib
    discard      = "on"
  }

  # Data disks carried from the source VM, on scsi1, scsi2, ...
  dynamic "disk" {
    for_each = each.value.data_gib
    content {
      datastore_id = var.datastore_id
      interface    = "scsi${disk.key + 1}"
      size         = disk.value
      discard      = "on"
    }
  }

  network_device {
    bridge   = var.bridge
    vlan_id  = each.value.vlan_id
    firewall = true
  }

  initialization {
    datastore_id = var.datastore_id
    ip_config {
      ipv4 {
        address = each.value.address
        gateway = each.value.gateway
      }
    }
  }
}

# Attach each VM's tier firewall security group (security.tf).
resource "proxmox_virtual_environment_firewall_rules" "vm" {
  for_each = local.vms

  node_name = var.node_name
  vm_id     = proxmox_virtual_environment_vm.vm[each.key].vm_id

  rule {
    security_group = each.value.sg
  }
}
