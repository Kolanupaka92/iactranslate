# Generated by IaCTranslate.
provider "nutanix" {
  username     = var.nutanix_username
  password     = var.nutanix_password
  endpoint     = var.prism_central_endpoint
  port         = 9440
  insecure     = var.nutanix_insecure
  wait_timeout = 10
}

# The cluster every VM and subnet lands on. On-premises there is no region to
# pick; there is a cluster the network team already runs.
data "nutanix_cluster" "target" {
  name = var.cluster_name
}
