{% if mandated_tags %}
# Generated by IaCTranslate.
# Nutanix has no free-form tags; the labelling primitive is the category (a
# key with a set of values). Mandated tags become one category key per tag,
# and every VM carries the mandated value — see compute.tf.
resource "nutanix_category_key" "mandated" {
  name        = "${var.project_name}-mandated"
  description = "Tags mandated by governance for {{ project }}."
}

{% for key, value in mandated_tags.items() %}
resource "nutanix_category_value" "mandated_{{ loop.index }}" {
  name  = nutanix_category_key.mandated.id
  value = "{{ key }}-{{ value }}"
}

{% endfor %}
{% endif %}
