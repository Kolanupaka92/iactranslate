# Generated by IaCTranslate — VLAN-backed subnets on the AHV cluster.
#
# On-premises there is no VPC to create: the address space {{ network.vpc_cidr }}
# is one your network team already routes. What is generated is one AHV subnet
# per planned tier/AZ, each declaring its range and gateway, riding on a VLAN
# id you assign (variables.tf). "AZ" here maps to nothing physical — AHV has
# no availability zones — but the split is kept so the plan is comparable
# with its public-cloud equivalents and so a second cluster can take the
# second half later.
#
# Address arithmetic assumes /24 subnets, which is what the planner carves
# (landing_zone.SUBNET_PREFIX). The gateway is .1 by convention; change it
# in Prism if your network uses a different one.
{% for subnet in network.subnets %}
resource "nutanix_subnet" "{{ subnet.resource_name }}" {
  cluster_uuid = data.nutanix_cluster.target.id
  name         = "${var.project_name}-{{ subnet.name }}"
  vlan_id      = var.vlan_id_{{ subnet.resource_name }}
  subnet_type  = "VLAN"

  subnet_ip          = "{{ subnet.cidr.split('/')[0] }}"
  prefix_length      = {{ subnet.cidr.split('/')[1] }}
  default_gateway_ip = "{{ subnet.cidr.split('/')[0].rsplit('.', 1)[0] }}.1"
  # IPAM pool for AHV-managed addresses: .10 through .250, leaving the low
  # range for gateways and static infrastructure.
  ip_config_pool_list_ranges = ["{{ subnet.cidr.split('/')[0].rsplit('.', 1)[0] }}.10 {{ subnet.cidr.split('/')[0].rsplit('.', 1)[0] }}.250"]
}

{% endfor %}
{% if network.nat_gateway %}
# The plan places workloads in private subnets that need controlled egress.
# On AHV that is a routing/NAT decision at your network edge, not a resource
# this provider creates — nothing is generated for it, and this note is here
# so the requirement is not lost.
{% endif %}
