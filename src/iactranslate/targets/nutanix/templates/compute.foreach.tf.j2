# Generated by IaCTranslate — AHV virtual machines, one resource over a per-VM
# map (the `for_each` layout, ADR 0073).
#
# Keys are the classic layout's labels, so `nutanix_virtual_machine.vm["app01"]`
# is the classic `nutanix_virtual_machine.app01`. Data disks are part of the
# VM's disk_list on AHV, so each row carries its disk sizes.
#
# Sizes come from a standard grid (targets/_onprem.py), not from the source
# allocation carried across exactly — that would reproduce the over-provisioning
# the migration exists to leave behind. Every value below is editable; AHV
# accepts any vCPU/memory combination.
#
# Images are referenced by the name you gave them in Prism Central
# (variables.tf). Windows source VMs stay Windows here.
{% for key in image_keys %}
data "nutanix_image" "{{ image_refs[key].resource }}" {
  image_name = var.{{ image_refs[key].variable }}
}

{% endfor %}
locals {
  vms = {
{% for c in compute %}
    "{{ c.resource_name }}" = {
      slug        = "{{ vm_slug[c.resource_name] }}"
      description = "Migrated from {{ c.vm_name }} ({{ c.tier.value }}, {{ c.environment.value }})"
      vcpus       = {{ c.vcpu }}
      memory_mib  = {{ (c.memory_gib * 1024) | int }}
      category    = nutanix_category_value.{{ sg_resource[c.security_group] }}.id
      image_id    = data.nutanix_image.{{ image_refs[c.image_key].resource }}.id
      root_mib    = {{ c.root_volume_gib * 1024 }}
      data_gib    = [{{ c.extra_volumes_gib | join(", ") }}]
      subnet_id   = nutanix_subnet.{{ subnet_of[c.vm_name] }}.id
    }
{% endfor %}
  }
}

resource "nutanix_virtual_machine" "vm" {
  for_each = local.vms

  name         = each.value.slug
  description  = each.value.description
  cluster_uuid = data.nutanix_cluster.target.id

  num_vcpus_per_socket = each.value.vcpus
  num_sockets          = 1
  memory_size_mib      = each.value.memory_mib

  # Tier category, so a Flow policy can target this VM (security.tf).
  categories {
    name  = nutanix_category_key.tier.id
    value = each.value.category
  }
{% for key, value in mandated_tags.items() %}
  categories {
    name  = nutanix_category_key.mandated.id
    value = nutanix_category_value.mandated_{{ loop.index }}.id
  }
{% endfor %}

  # Root disk, cloned from the uploaded image.
  disk_list {
    data_source_reference = {
      kind = "image"
      uuid = each.value.image_id
    }
    disk_size_mib = each.value.root_mib
  }

  # Data disks carried from the source VM, numbered from 1 after the root disk.
  dynamic "disk_list" {
    for_each = each.value.data_gib
    content {
      disk_size_mib = disk_list.value * 1024
      device_properties {
        device_type = "DISK"
        disk_address = {
          device_index = disk_list.key + 1
          adapter_type = "SCSI"
        }
      }
    }
  }

  nic_list {
    subnet_uuid = each.value.subnet_id
  }
}
