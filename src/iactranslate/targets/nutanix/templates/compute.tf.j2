# Generated by IaCTranslate — AHV virtual machines (one per source VM).
#
# Sizes come from a standard grid (targets/_onprem.py), not from the source
# allocation carried across exactly — that would reproduce the over-provisioning
# the migration exists to leave behind. Every value below is editable; AHV
# accepts any vCPU/memory combination.
#
# Images are referenced by the name you gave them in Prism Central
# (variables.tf). Windows source VMs stay Windows here.
{% for key in image_keys %}
data "nutanix_image" "{{ image_refs[key].resource }}" {
  image_name = var.{{ image_refs[key].variable }}
}

{% endfor %}
{% for c in compute %}
resource "nutanix_virtual_machine" "{{ c.resource_name }}" {
  name         = "{{ vm_slug[c.vm_name] }}"
  description  = "Migrated from {{ c.vm_name }} ({{ c.tier.value }}, {{ c.environment.value }})"
  cluster_uuid = data.nutanix_cluster.target.id

  num_vcpus_per_socket = {{ c.vcpu }}
  num_sockets          = 1
  memory_size_mib      = {{ (c.memory_gib * 1024) | int }}

  # Tier category, so a Flow policy can target this VM (security.tf).
  categories {
    name  = nutanix_category_key.tier.id
    value = nutanix_category_value.{{ sg_resource[c.security_group] }}.id
  }
{% for key, value in mandated_tags.items() %}
  categories {
    name  = nutanix_category_key.mandated.id
    value = nutanix_category_value.mandated_{{ loop.index }}.id
  }
{% endfor %}

  # Root disk, cloned from the uploaded image.
  disk_list {
    data_source_reference = {
      kind = "image"
      uuid = data.nutanix_image.{{ image_refs[c.image_key].resource }}.id
    }
    disk_size_mib = {{ c.root_volume_gib * 1024 }}
  }
{% for size in c.extra_volumes_gib %}
  # Data disk {{ loop.index }} ({{ size }} GiB) — carried from the source VM.
  disk_list {
    disk_size_mib = {{ size * 1024 }}
    device_properties {
      device_type = "DISK"
      disk_address = {
        device_index = {{ loop.index }}
        adapter_type = "SCSI"
      }
    }
  }
{% endfor %}

  nic_list {
    subnet_uuid = nutanix_subnet.{{ subnet_of[c.vm_name] }}.id
  }
}

{% endfor %}
