# Generated by IaCTranslate — categories, and the firewall intent per tier.
#
# Nutanix has no security group attached to a NIC. Its segmentation model is
# Flow: a policy that targets VMs by *category*. So each tier becomes a
# category value here, every VM in compute.tf carries its tier's value, and a
# Flow policy can target it.
#
# The Flow rules themselves are deliberately NOT generated. Flow's policy
# schema (app-type rules with inbound/outbound allow lists keyed on category
# filters) is licence-dependent and intricate enough that a wrong-but-valid
# rule would pass `terraform validate` and still leave a port open. Emitting
# nothing and stating the intent is safer than emitting something plausible.
# The intended ingress per tier is recorded below so it can be authored — or
# fed to Flow's policy import — without re-deriving it from the plan.
resource "nutanix_category_key" "tier" {
  name        = "${var.project_name}-tier"
  description = "Workload tier, for Flow microsegmentation policies."
}

{% for sg in network.security_groups %}
resource "nutanix_category_value" "{{ sg.resource_name }}" {
  name  = nutanix_category_key.tier.id
  value = "{{ sg.name }}"
}

# Intended ingress for tier "{{ sg.name }}":
{% for rule in sg.ingress %}
#   allow {{ rule.protocol }} {{ rule.from_port }}{% if rule.to_port != rule.from_port %}-{{ rule.to_port }}{% endif %} from {{ rule.cidr_blocks | join(", ") }}   ({{ rule.description }})
{% endfor %}

{% endfor %}
