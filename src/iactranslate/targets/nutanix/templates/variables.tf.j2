# Generated by IaCTranslate.
variable "project_name" {
  description = "Project name used as a resource name prefix and category value."
  type        = string
  default     = "{{ project_slug }}"
}

variable "prism_central_endpoint" {
  description = "Prism Central hostname or IP."
  type        = string
  default     = "REPLACE_ME_PRISM_CENTRAL"
}

variable "nutanix_username" {
  description = "Prism Central user with VM and network management rights."
  type        = string
  default     = "REPLACE_ME_USERNAME"
}

variable "nutanix_password" {
  description = "Prism Central password. Set before `terraform apply`."
  type        = string
  sensitive   = true
  default     = "REPLACE_ME_PASSWORD"
}

variable "nutanix_insecure" {
  description = "Skip TLS verification of Prism Central. Only for self-signed lab certificates."
  type        = bool
  default     = false
}

variable "cluster_name" {
  description = "Name of the AHV cluster (as shown in Prism Central) to deploy into."
  type        = string
  default     = "{{ region }}"
}

# VLAN ids are owned by the network team, not the tool. Each generated subnet
# declares its address range; the VLAN it rides on is yours to assign.
{% for subnet in network.subnets %}
variable "vlan_id_{{ subnet.resource_name }}" {
  description = "VLAN id for subnet {{ subnet.name }} ({{ subnet.cidr }}, {{ subnet.tier.value }})."
  type        = number
  default     = {{ 100 + loop.index0 }}
}

{% endfor %}
# Images are uploaded to Prism Central by you; there is no public catalog on a
# cluster. Set each to the name of the image as it appears in Prism Central.
{% for key in image_keys %}
variable "{{ image_refs[key].variable }}" {
  description = "Name of the uploaded {{ key }} image in Prism Central."
  type        = string
  default     = "REPLACE_ME_{{ image_refs[key].variable | upper }}"
}

{% endfor %}
