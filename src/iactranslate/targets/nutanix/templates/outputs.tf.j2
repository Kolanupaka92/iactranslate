# Generated by IaCTranslate — useful outputs.
output "cluster_uuid" {
  description = "UUID of the AHV cluster the estate landed on."
  value       = data.nutanix_cluster.target.id
}

output "vm_ids" {
  description = "Map of source VM name to AHV VM UUID."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = nutanix_virtual_machine.{{ c.resource_name }}.id
{% endfor %}
  }
}

output "subnet_ids" {
  description = "Map of subnet name to AHV subnet UUID."
  value = {
{% for subnet in network.subnets %}
    "{{ subnet.name }}" = nutanix_subnet.{{ subnet.resource_name }}.id
{% endfor %}
  }
}
