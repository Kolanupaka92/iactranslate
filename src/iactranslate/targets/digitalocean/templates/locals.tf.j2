{% if mandated_tags %}
# Generated by IaCTranslate.
# DigitalOcean tags are first-class resources and a flat list of strings, not
# key/value pairs — a Droplet can only carry a tag that already exists. Mandated
# tags are therefore created here and encoded as `key:value`, DigitalOcean's own
# documented convention, rather than silently dropped on this one cloud.
{% for tag in mandated_do_tags %}
resource "digitalocean_tag" "mandated_{{ loop.index }}" {
  name = "{{ tag }}"
}
{% endfor %}
{% endif %}
