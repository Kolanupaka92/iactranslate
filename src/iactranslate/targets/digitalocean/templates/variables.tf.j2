# Generated by IaCTranslate.
variable "region" {
  description = "DigitalOcean region to deploy into."
  type        = string
  default     = "{{ region }}"
}

variable "project_name" {
  description = "Project name used as a resource name prefix and tag."
  type        = string
  default     = "{{ project_slug }}"
}

variable "do_token" {
  description = "DigitalOcean API token (Personal Access Token). Set before `terraform apply`."
  type        = string
  sensitive   = true
  default     = "REPLACE_ME_DO_TOKEN"
}

variable "ssh_key_fingerprints" {
  description = "Fingerprints of SSH keys (already uploaded to your DO account) to install on Linux Droplets."
  type        = list(string)
  default     = []
}

# Images are resolved automatically to public image slugs (see mapping in
# compute.tf) — no image ids to fill in. DigitalOcean has no Windows Server
# image; Windows source VMs render as Ubuntu Droplets — see README.md.
