# Generated by IaCTranslate — useful outputs.
output "vpc_id" {
  description = "ID of the migration VPC."
  value       = digitalocean_vpc.main.id
}

output "droplet_ids" {
  description = "Map of source VM name to migrated Droplet ID."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = digitalocean_droplet.{{ c.resource_name }}.id
{% endfor %}
  }
}

output "droplet_public_ips" {
  description = "Map of source VM name to public IPv4."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = digitalocean_droplet.{{ c.resource_name }}.ipv4_address
{% endfor %}
  }
}

output "droplet_private_ips" {
  description = "Map of source VM name to VPC-internal IPv4."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = digitalocean_droplet.{{ c.resource_name }}.ipv4_address_private
{% endfor %}
  }
}
