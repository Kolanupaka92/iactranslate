# Generated by IaCTranslate — Droplets (one per source VM).
#
# Two honest DigitalOcean platform differences from AWS/Azure/GCP/OCI:
#  - Every Droplet gets a public IPv4 by default; there is no flag on this
#    resource to suppress it. "Private" tier isolation here comes entirely
#    from firewall rules (VPC-CIDR-scoped ingress — see security.tf), not
#    from lacking a public IP. For real IP-level isolation, front private
#    tiers with a jump host / VPN.
#  - Root disk size is bundled into the Droplet `size` slug, not
#    independently settable — c.root_volume_gib isn't used for the root
#    disk. Extra volumes (storage.tf) are real, independently-sized disks.
{% for c in compute %}
resource "digitalocean_droplet" "{{ c.resource_name }}" {
  name     = "{{ vm_slug[c.vm_name] }}"
  region   = var.region
  size     = "{{ c.instance_type }}"
  image    = "{{ image_refs[c.image_key].slug }}"
  vpc_uuid = digitalocean_vpc.main.id
  tags     = [
    digitalocean_tag.{{ sg_resource[c.security_group] }}.name,
{% if c.vm_name in fronted_vm_names %}
    digitalocean_tag.{{ lb_resource_of[c.vm_name] }}_lb.name,
{% endif %}
  ]
  ssh_keys = var.ssh_key_fingerprints

  monitoring = true
}

{% endfor %}
