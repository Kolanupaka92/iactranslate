# Generated by IaCTranslate — VPC.
#
# DigitalOcean's network model has no subnet resource and no managed NAT
# gateway product — a VPC is one flat CIDR per region, and Droplets join it
# directly (no per-AZ subnet to place them in). The public/private tier
# distinction the rest of the plan carries (see compute.tf) is enforced by
# whether a Droplet gets a public IP, not by which subnet it's in.
resource "digitalocean_vpc" "main" {
  name     = "${var.project_name}-vpc"
  region   = var.region
  ip_range = "{{ network.vpc_cidr }}"
}
