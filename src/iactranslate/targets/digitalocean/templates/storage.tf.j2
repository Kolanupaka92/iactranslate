# Generated by IaCTranslate — additional block storage volumes.
{% if volumes %}
{% for v in volumes %}
resource "digitalocean_volume" "{{ v.resource_name }}" {
  name                    = "{{ v.vm_name }}-data-{{ v.lun }}"
  region                  = var.region
  size                    = {{ v.size }}
  initial_filesystem_type = "ext4"
}

resource "digitalocean_volume_attachment" "{{ v.resource_name }}" {
  droplet_id = digitalocean_droplet.{{ v.instance_resource }}.id
  volume_id  = digitalocean_volume.{{ v.resource_name }}.id
}

{% endfor %}
{% else %}
# No additional block volumes — all source VMs fit on the size-bundled disk.
{% endif %}
