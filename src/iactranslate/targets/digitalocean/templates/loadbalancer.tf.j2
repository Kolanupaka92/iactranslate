{% if network.load_balancers %}
# Generated by IaCTranslate — Load Balancers fronting multi-instance tiers.
#
# Honest platform note: DigitalOcean Load Balancers always get a public IP —
# there is no internal-only option the way AWS/Azure/GCP/OCI offer. An
# "internal" tier here is still fronted by a real DO load balancer; treat its
# public reachability the same way you'd treat any internet-facing resource
# and rely on the firewall (security.tf) for access control.
#
# DO targets a load balancer by tag (all Droplets carrying it), not by
# explicit instance list — each LB gets its own dedicated tag, applied only
# to its target instances in compute.tf, so it can't pick up unrelated
# same-tier Droplets from a different environment.
{% for lb in network.load_balancers %}
resource "digitalocean_tag" "{{ lb.resource_name }}_lb" {
  name = "${var.project_name}-{{ lb.name }}"
}

resource "digitalocean_loadbalancer" "{{ lb.resource_name }}" {
  name     = "${var.project_name}-{{ lb.name }}"
  region   = var.region
  vpc_uuid = digitalocean_vpc.main.id
  droplet_tag = digitalocean_tag.{{ lb.resource_name }}_lb.name

{% for listener in lb.listeners %}
  forwarding_rule {
    entry_protocol  = "tcp"
    entry_port      = {{ listener.listener_port }}
    target_protocol = "tcp"
    target_port     = {{ listener.target_port }}
  }

{% endfor %}
  healthcheck {
    protocol = "tcp"
    port     = {{ lb.listeners[0].target_port }}
  }
}

{% endfor %}
{% endif %}
