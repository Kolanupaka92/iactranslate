# Generated by IaCTranslate — tags (DigitalOcean's firewall/grouping
# primitive) and firewalls. DO firewalls attach by tag, not by subnet or NIC.
{% for sg in network.security_groups %}
resource "digitalocean_tag" "{{ sg.resource_name }}" {
  name = "${var.project_name}-{{ sg.name }}"
}

resource "digitalocean_firewall" "{{ sg.resource_name }}" {
  name = "${var.project_name}-{{ sg.name }}"
  tags = [digitalocean_tag.{{ sg.resource_name }}.name]

{% for rule in sg.ingress %}
  inbound_rule {
    protocol         = "{{ rule.protocol }}"
    port_range       = "{{ rule.from_port }}{% if rule.to_port != rule.from_port %}-{{ rule.to_port }}{% endif %}"
    source_addresses = [{% for cidr in rule.cidr_blocks %}"{{ cidr }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  }

{% endfor %}
  outbound_rule {
    protocol              = "tcp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "udp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
}

{% endfor %}
