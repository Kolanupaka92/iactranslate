# Generated by IaCTranslate — additional block storage volumes, one resource over a map.
{% if volumes %}
# Keyed like the classic layout's labels: `digitalocean_volume.data["app01_data_1"]`.
locals {
  data_volumes = {
{% for v in volumes %}
    "{{ v.resource_name }}" = { vm = "{{ v.instance_resource }}", name = "{{ v.vm_name }}", size = {{ v.size }}, lun = {{ v.lun }} }
{% endfor %}
  }
}

resource "digitalocean_volume" "data" {
  for_each = local.data_volumes

  name                    = "${each.value.name}-data-${each.value.lun}"
  region                  = var.region
  size                    = each.value.size
  initial_filesystem_type = "ext4"
}

resource "digitalocean_volume_attachment" "data" {
  for_each = local.data_volumes

  droplet_id = digitalocean_droplet.vm[each.value.vm].id
  volume_id  = digitalocean_volume.data[each.key].id
}
{% else %}
# No additional block volumes — all source VMs fit on the size-bundled disk.
{% endif %}
