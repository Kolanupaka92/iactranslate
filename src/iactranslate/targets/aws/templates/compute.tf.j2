# Generated by IaCTranslate — EC2 instances (one per source VM).
{% for c in compute %}
resource "aws_instance" "{{ c.resource_name }}" {
{% if identity_roles %}
  iam_instance_profile = aws_iam_instance_profile.{{ c.tier.value }}.name
{% endif %}
  ami                    = lookup(var.ami_overrides, "{{ c.image_key }}", data.aws_ami.{{ image_refs[c.image_key].resource }}.id)
  instance_type          = "{{ c.instance_type }}"
  subnet_id              = aws_subnet.{{ subnet_of[c.vm_name] }}.id
  vpc_security_group_ids = [aws_security_group.{{ sg_resource[c.security_group] }}.id]

  root_block_device {
    volume_size = {{ c.root_volume_gib }}
    volume_type = "gp3"
    # EBS is NOT encrypted by default unless the account enables it per-region,
    # so this is set explicitly. CIS AWS Foundations 2.2.1 checks for it, and an
    # unencrypted root volume is the finding that stops a security review.
    encrypted   = true
{% if kms_key_id %}
    kms_key_id  = "{{ kms_key_id }}"
{% endif %}
  }

  tags = {
    Name        = "{{ c.vm_name }}"
    Tier        = "{{ c.tier.value }}"
    Environment = "{{ c.environment.value }}"
    SourceVM    = "{{ c.vm_name }}"
  }

  lifecycle {
    # images.tf finds the newest image on every run. Without this, each one its
    # vendor publishes would replace this server and its boot disk. To rebuild
    # on a newer image on purpose: terraform apply -replace=<address>
{% if c.external_id %}
    # Adopted (imports.tf): it keeps its own network, security groups and boot
    # disk. A new subnet or disk encryption would replace it, and security groups
    # from another network can't be attached (ADR 0091).
    ignore_changes = [ami, subnet_id, vpc_security_group_ids, root_block_device]
{% else %}
    ignore_changes = [ami]
{% endif %}
  }
}

{% endfor %}
