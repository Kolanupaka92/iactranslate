{% set adopt = compute | selectattr("external_id") | list %}
{% if adopt %}
# Generated by IaCTranslate — brownfield adoption.
# These workloads already exist in AWS. `terraform plan` will IMPORT them into
# state (adopt them) instead of proposing to create duplicates. Requires
# Terraform >= 1.5 / OpenTofu.
{% for c in adopt %}
import {
  to = aws_instance.{{ c.resource_name }}
  id = "{{ c.external_id }}"
}
{% endfor %}
{% endif %}
