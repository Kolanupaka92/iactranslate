{% set adopt = compute | selectattr("external_id") | list %}
{% if adopt %}
# Generated by IaCTranslate — brownfield adoption.
# These workloads already exist in AWS. `terraform plan` will IMPORT them into
# state (adopt them) instead of proposing to create duplicates. Requires
# Terraform >= 1.5 / OpenTofu.
#
# An adopted server stays where it is: in its own network, with its own security
# groups, image and boot disk (see `ignore_changes` in compute.tf). The new
# network is for new servers. A different instance type is applied in place,
# which stops and starts the server. Read the plan: it must say "import" and
# never "replace" for these (ADR 0091).
{% for c in adopt %}
import {
  to = aws_instance.{{ instance_addr[c.vm_name] }}
  id = "{{ c.external_id }}"
}
{% endfor %}
{% endif %}
