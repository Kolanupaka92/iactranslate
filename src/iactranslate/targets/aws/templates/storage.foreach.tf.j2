# Generated by IaCTranslate — additional data volumes, one resource over a map.
{% if volumes %}
# Keyed like the classic layout's labels: `aws_ebs_volume.data["prod_web_01_data_1"]`.
locals {
  data_volumes = {
{% for v in volumes %}
    "{{ v.resource_name }}" = { vm = "{{ v.instance_resource }}", name = "{{ v.vm_name }}", size = {{ v.size }}, device = "{{ v.device }}" }
{% endfor %}
  }
}

resource "aws_ebs_volume" "data" {
  for_each = local.data_volumes

  availability_zone = aws_instance.vm[each.value.vm].availability_zone
  size              = each.value.size
  type              = "gp3"
  encrypted         = true
{% if kms_key_id %}
  kms_key_id        = "{{ kms_key_id }}"
{% endif %}

  tags = {
    Name     = "${each.value.name}-data"
    SourceVM = each.value.name
  }
}

resource "aws_volume_attachment" "data" {
  for_each = local.data_volumes

  device_name = each.value.device
  volume_id   = aws_ebs_volume.data[each.key].id
  instance_id = aws_instance.vm[each.value.vm].id
}
{% else %}
# No additional data volumes — all source VMs fit on a single root volume.
{% endif %}
