# Generated by IaCTranslate — additional data volumes.
{% if volumes %}
{% for v in volumes %}
resource "aws_ebs_volume" "{{ v.resource_name }}" {
  availability_zone = aws_instance.{{ v.instance_resource }}.availability_zone
  size              = {{ v.size }}
  type              = "gp3"

  tags = {
    Name     = "{{ v.vm_name }}-data"
    SourceVM = "{{ v.vm_name }}"
  }
}

resource "aws_volume_attachment" "{{ v.resource_name }}" {
  device_name = "{{ v.device }}"
  volume_id   = aws_ebs_volume.{{ v.resource_name }}.id
  instance_id = aws_instance.{{ v.instance_resource }}.id
}

{% endfor %}
{% else %}
# No additional data volumes — all source VMs fit on a single root volume.
{% endif %}
