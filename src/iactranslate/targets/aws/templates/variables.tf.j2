# Generated by IaCTranslate.
variable "region" {
  description = "AWS region to deploy into."
  type        = string
  default     = "{{ region }}"
}

variable "project_name" {
  description = "Project name applied as a default tag."
  type        = string
  default     = "{{ project }}"
}

variable "ami_ids" {
  description = <<-EOT
    AMI ID per logical OS key. IaCTranslate cannot know your account's AMIs, so
    fill these in before `terraform apply` (e.g. from an aws_ami data source or
    your golden images). Keys correspond to the OS detected on each source VM.
  EOT
  type = map(string)
  default = {
{% for key in image_keys %}
    "{{ key }}" = "ami-REPLACE_ME"
{% endfor %}
  }
}
