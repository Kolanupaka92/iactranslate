# Generated by IaCTranslate.
variable "region" {
  description = "AWS region to deploy into."
  type        = string
  default     = "{{ region }}"
}

variable "project_name" {
  description = "Project name applied as a default tag."
  type        = string
  default     = "{{ project }}"
}

variable "ami_overrides" {
  description = <<-EOT
    Optional. AMIs are resolved automatically by the data sources in images.tf.
    Override per logical OS key only to pin a specific/golden AMI, e.g.
    { "ubuntu-22.04" = "ami-0123456789abcdef0" }.
  EOT
  type    = map(string)
  default = {}
}

{% if has_https_listener %}
variable "acm_certificate_arn" {
  description = <<-EOT
    Required for HTTPS load balancer listeners (loadbalancer.tf) - no ACM
    certificate can be known at generation time. Request/import one in ACM
    and set its ARN here before deploying.
  EOT
  type    = string
  default = ""
}
{% endif %}
