# Generated by IaCTranslate — VPC, subnets, gateways, and routing.
data "aws_availability_zones" "available" {
  state = "available"
}

resource "aws_vpc" "main" {
  cidr_block           = "{{ network.vpc_cidr }}"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name = "${var.project_name}-vpc"
  }
}

{% if network.internet_gateway %}
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.project_name}-igw"
  }
}
{% endif %}

{% for subnet in network.subnets %}
resource "aws_subnet" "{{ subnet.resource_name }}" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "{{ subnet.cidr }}"
  availability_zone       = data.aws_availability_zones.available.names[{{ subnet.availability_zone_index }}]
  map_public_ip_on_launch = {{ "true" if subnet.tier == SubnetTier.PUBLIC else "false" }}

  tags = {
    Name = "${var.project_name}-{{ subnet.name }}"
    Tier = "{{ subnet.tier.value }}"
  }
}

{% endfor %}
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

{% if network.internet_gateway %}
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }
{% endif %}

  tags = {
    Name = "${var.project_name}-public-rt"
  }
}

{% for subnet in network.subnets %}
{% if subnet.tier == SubnetTier.PUBLIC %}
resource "aws_route_table_association" "{{ subnet.resource_name }}" {
  subnet_id      = aws_subnet.{{ subnet.resource_name }}.id
  route_table_id = aws_route_table.public.id
}

{% endif %}
{% endfor %}
{% if network.nat_gateway %}
resource "aws_eip" "nat" {
  domain = "vpc"

  tags = {
    Name = "${var.project_name}-nat-eip"
  }
}

resource "aws_nat_gateway" "main" {
  allocation_id = aws_eip.nat.id
  subnet_id     = aws_subnet.{{ (network.subnets | selectattr("tier", "equalto", SubnetTier.PUBLIC) | list | first).resource_name }}.id

  tags = {
    Name = "${var.project_name}-nat"
  }

  depends_on = [aws_internet_gateway.main]
}

resource "aws_route_table" "private" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.main.id
  }

  tags = {
    Name = "${var.project_name}-private-rt"
  }
}

{% for subnet in network.subnets %}
{% if subnet.tier == SubnetTier.PRIVATE %}
resource "aws_route_table_association" "{{ subnet.resource_name }}" {
  subnet_id      = aws_subnet.{{ subnet.resource_name }}.id
  route_table_id = aws_route_table.private.id
}

{% endif %}
{% endfor %}
{% endif %}
