{% if network.load_balancers %}
# Generated by IaCTranslate — application load balancers fronting multi-instance tiers.
{% for lb in network.load_balancers %}
resource "aws_lb" "{{ lb.resource_name }}" {
  name               = "{{ lb.resource_name | replace('_', '-') }}"
  internal           = {{ "false" if lb.internet_facing else "true" }}
  load_balancer_type = "application"
  security_groups    = [aws_security_group.{{ sg_resource[lb.security_group] }}.id]
  subnets = [
{% for subnet in network.subnets %}
{% if subnet.tier == lb.subnet_tier %}
    aws_subnet.{{ subnet.resource_name }}.id,
{% endif %}
{% endfor %}
  ]

  tags = {
    Name = "${var.project_name}-{{ lb.name }}"
  }
}

{% for listener in lb.listeners %}
resource "aws_lb_target_group" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  name     = "{{ (lb.resource_name ~ "-" ~ listener.listener_port) | replace('_', '-') }}"
  port     = {{ listener.target_port }}
  protocol = "{{ listener.protocol }}"
  vpc_id   = aws_vpc.main.id

  health_check {
    path = "{{ lb.health_check_path }}"
  }
}

{% for c in compute %}
{% if c.vm_name in lb.targets %}
resource "aws_lb_target_group_attachment" "{{ lb.resource_name }}_{{ listener.listener_port }}_{{ c.resource_name }}" {
  target_group_arn = aws_lb_target_group.{{ lb.resource_name }}_{{ listener.listener_port }}.arn
  target_id        = aws_instance.{{ c.resource_name }}.id
  port             = {{ listener.target_port }}
}

{% endif %}
{% endfor %}
resource "aws_lb_listener" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  load_balancer_arn = aws_lb.{{ lb.resource_name }}.arn
  port              = {{ listener.listener_port }}
  protocol          = "{{ listener.protocol }}"
{% if listener.protocol == "HTTPS" %}
  ssl_policy        = "ELBSecurityPolicy-2016-08"
  certificate_arn   = var.acm_certificate_arn
{% endif %}

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.{{ lb.resource_name }}_{{ listener.listener_port }}.arn
  }
}

{% endfor %}
{% endfor %}
{% endif %}
