# Generated by IaCTranslate — AMI lookups (resolve the latest matching image at apply time).
{% for key, ref in image_refs.items() %}
data "aws_ami" "{{ ref.resource }}" {
  most_recent = true
  owners      = [{% for o in ref.owners %}"{{ o }}"{% if not loop.last %}, {% endif %}{% endfor %}]

  filter {
    name   = "name"
    values = ["{{ ref.name }}"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

{% endfor %}
