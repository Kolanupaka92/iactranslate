{% if identity_roles %}
# Generated by IaCTranslate — workload identity.
#
# One role per tier, wired to the instances, with NO permissions attached.
# Attaching policies is yours: what a workload may access is not derivable from
# an inventory, and a guess is either too narrow to work or too broad to be safe.
#
#   resource "aws_iam_role_policy_attachment" "app_reads_config" {
#     role       = aws_iam_role.app.name
#     policy_arn = aws_iam_policy.your_policy.arn
#   }
{% for tier in identity_roles %}

resource "aws_iam_role" "{{ tier }}" {
  name = "${var.project_name}-{{ tier }}"

  # Only EC2 may assume this role. A trust policy naming the wrong principal
  # produces a role nothing can use, and the failure appears at runtime.
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })
}

resource "aws_iam_instance_profile" "{{ tier }}" {
  name = "${var.project_name}-{{ tier }}"
  role = aws_iam_role.{{ tier }}.name
}
{% if identity_mode == "ssm" %}

# Keyless, auditable shell access: no SSH port, no bastion, no key pair.
resource "aws_iam_role_policy_attachment" "{{ tier }}_ssm" {
  role       = aws_iam_role.{{ tier }}.name
  policy_arn = "{{ ssm_policy_arn }}"
}
{% endif %}
{% endfor %}
{% endif %}
