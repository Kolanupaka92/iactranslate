{% if hybrid and hybrid.required %}
# Generated by IaCTranslate — hybrid connectivity to networks that are NOT migrating.
#
# Derived from observed network flows: these are addresses the estate actually
# talks to that are absent from the inventory, so nothing is moving them. Cut
# over without reaching them and the workloads start and fail to work.
{% for note in hybrid.notes %}
#
# {{ note }}
{% endfor %}
{% if hybrid.conflicts %}

# ---------------------------------------------------------------------------
# STOP. These on-prem networks overlap this VPC's own range ({{ hybrid.vpc_cidr }}):
{% for net in hybrid.conflicts %}
#   {{ net.cidr }}  ({{ net.connections }} connections from {{ net.dependent_workloads | length }} workload(s))
{% endfor %}
#
# No route to them can be created. The VPC claims those addresses, so traffic
# stays inside the VPC and never reaches the corporate network. This is not
# fixable with routing: the landing zone CIDR must be reallocated, which
# re-plans every subnet. Do it before cutover.
#
# No connectivity is generated for the ranges above, because none can work.
# ---------------------------------------------------------------------------
{% endif %}
{% if hybrid.routable %}

# The customer gateway is the customer's own edge router. Its public address and
# BGP ASN are properties of that device and cannot be inferred from an
# inventory, so they are declared with NO default: `terraform plan` fails until
# a human supplies them. That is deliberate — a plausible-looking placeholder
# that applied cleanly would build a tunnel to nowhere.
variable "on_prem_gateway_ip" {
  type        = string
  description = "Public IP of the on-premises VPN endpoint (from the network team)"
}

variable "on_prem_bgp_asn" {
  type        = number
  description = "BGP ASN of the on-premises router"
  default     = 65000
}

locals {
  # Summarised to /{{ SUMMARY_PREFIX }} from observed traffic. Narrow these to what your
  # network team actually routes before applying.
  on_prem_cidrs = [
{% for net in hybrid.routable %}
    "{{ net.cidr }}", # {{ net.connections }} connections, ports {{ net.ports | join(", ") }}
{% endfor %}
  ]
}

resource "aws_customer_gateway" "on_prem" {
  bgp_asn    = var.on_prem_bgp_asn
  ip_address = var.on_prem_gateway_ip
  type       = "ipsec.1"

  tags = {
    Name = "${var.project_name}-on-prem"
  }
}

resource "aws_vpn_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.project_name}-vgw"
  }
}

resource "aws_vpn_connection" "on_prem" {
  customer_gateway_id = aws_customer_gateway.on_prem.id
  vpn_gateway_id      = aws_vpn_gateway.main.id
  type                = "ipsec.1"
  static_routes_only  = true

  tags = {
    Name = "${var.project_name}-vpn"
  }
}

resource "aws_vpn_connection_route" "on_prem" {
  for_each               = toset(local.on_prem_cidrs)
  destination_cidr_block = each.value
  vpn_connection_id      = aws_vpn_connection.on_prem.id
}

# Routes to on-prem from every route table that exists. Without these the
# tunnel is up and nothing uses it, which is the failure that looks like success.
resource "aws_route" "to_on_prem_public" {
  for_each               = toset(local.on_prem_cidrs)
  route_table_id         = aws_route_table.public.id
  destination_cidr_block = each.value
  gateway_id             = aws_vpn_gateway.main.id
}
{% if network.nat_gateway %}

resource "aws_route" "to_on_prem_private" {
  for_each               = toset(local.on_prem_cidrs)
  route_table_id         = aws_route_table.private.id
  destination_cidr_block = each.value
  gateway_id             = aws_vpn_gateway.main.id
}
{% endif %}

# Direct Connect is deliberately NOT generated. A dedicated circuit is a
# physical cross-connect ordered from AWS or a partner with a lead time in
# weeks; `aws_dx_connection` bills a port from the moment it applies. Emitting
# one from an inventory scan would charge a customer for hardware they did not
# ask for. Once a circuit exists, replace `aws_vpn_gateway` with an
# `aws_dx_gateway` association — the routes above are unchanged.
{% endif %}
{% endif %}
