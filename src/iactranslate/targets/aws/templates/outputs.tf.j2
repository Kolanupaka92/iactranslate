# Generated by IaCTranslate — useful outputs.
output "vpc_id" {
  description = "ID of the migration VPC."
  value       = aws_vpc.main.id
}

output "subnet_ids" {
  description = "Map of subnet name to ID."
  value = {
{% for subnet in network.subnets %}
    "{{ subnet.name }}" = aws_subnet.{{ subnet.resource_name }}.id
{% endfor %}
  }
}

output "instance_ids" {
  description = "Map of source VM name to migrated EC2 instance ID."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = aws_instance.{{ c.resource_name }}.id
{% endfor %}
  }
}

output "instance_private_ips" {
  description = "Map of source VM name to private IP."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = aws_instance.{{ c.resource_name }}.private_ip
{% endfor %}
  }
}

{% if network.load_balancers %}
output "load_balancer_dns_names" {
  description = "Map of load balancer name to its public DNS name."
  value = {
{% for lb in network.load_balancers %}
    "{{ lb.name }}" = aws_lb.{{ lb.resource_name }}.dns_name
{% endfor %}
  }
}
{% endif %}
