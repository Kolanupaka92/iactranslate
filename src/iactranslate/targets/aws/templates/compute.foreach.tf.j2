# Generated by IaCTranslate — EC2 instances, one resource over a per-VM map.
#
# The `for_each` layout (ADR 0073): every machine is a row in `local.vms`, and
# the resource below is written once. Reviewing a change to one machine means
# reading one row; reviewing the resource logic means reading it once, not
# once per machine. Keys are the same labels the classic layout uses, so
# `aws_instance.vm["prod_web_01"]` is the classic `aws_instance.prod_web_01`.

{% macro rows(machines) %}
{% for c in machines %}
    "{{ c.resource_name }}" = {
      name          = "{{ c.vm_name }}"
      ami           = lookup(var.ami_overrides, "{{ c.image_key }}", data.aws_ami.{{ image_refs[c.image_key].resource }}.id)
      instance_type = "{{ c.instance_type }}"
      subnet_id     = aws_subnet.{{ subnet_of[c.vm_name] }}.id
      public_ip     = {{ "true" if c.vm_name in public_vm_names else "false" }}
      sg_id         = aws_security_group.{{ sg_resource[c.security_group] }}.id
      root_gib      = {{ c.root_volume_gib }}
{% if identity_roles %}
      profile       = aws_iam_instance_profile.{{ c.tier.value }}.name
{% endif %}
      tier          = "{{ c.tier.value }}"
      environment   = "{{ c.environment.value }}"
    }
{% endfor %}
{% endmacro %}
locals {
  vms = {
{{ rows(compute | rejectattr("external_id") | list) }}  }
{% if compute | selectattr("external_id") | list %}
  # Adopted servers (imports.tf), a resource of their own because they ignore
  # more: they keep their own network, security groups and boot disk (ADR 0091).
  adopted = {
{{ rows(compute | selectattr("external_id") | list) }}  }
  # Every instance by key, for disks.
  instances = merge(aws_instance.vm, aws_instance.adopted)
{% else %}
  # Every instance by key, for disks.
  instances = aws_instance.vm
{% endif %}
}

{% macro instance(name, rows, ignored) %}
resource "aws_instance" "{{ name }}" {
  for_each = local.{{ rows }}

{% if identity_roles %}
  iam_instance_profile   = each.value.profile
{% endif %}
  ami                    = each.value.ami
  instance_type          = each.value.instance_type
  subnet_id              = each.value.subnet_id
  vpc_security_group_ids = [each.value.sg_id]
  # Only a machine with no load balancer in front gets its own public address (ADR 0095).
  associate_public_ip_address = each.value.public_ip

  root_block_device {
    volume_size = each.value.root_gib
    volume_type = "gp3"
    # EBS is NOT encrypted by default unless the account enables it per-region,
    # so this is set explicitly. CIS AWS Foundations 2.2.1 checks for it, and an
    # unencrypted root volume is the finding that stops a security review.
    encrypted   = true
{% if kms_key_id %}
    kms_key_id  = "{{ kms_key_id }}"
{% endif %}
  }

  tags = {
    Name        = each.value.name
    Tier        = each.value.tier
    Environment = each.value.environment
    SourceVM    = each.value.name
  }

  lifecycle {
    # images.tf finds the newest image on every run. Without this, each one its
    # vendor publishes would replace this server and its boot disk. To rebuild
    # on a newer image on purpose: terraform apply -replace=<address>
    ignore_changes = [{{ ignored }}]
  }
}
{% endmacro %}
{{ instance("vm", "vms", "ami") }}
{% if compute | selectattr("external_id") | list %}

{{ instance("adopted", "adopted", "ami, subnet_id, vpc_security_group_ids, root_block_device, associate_public_ip_address") }}
{% endif %}
