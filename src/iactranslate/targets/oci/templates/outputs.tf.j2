# Generated by IaCTranslate — useful outputs.
output "vcn_id" {
  description = "OCID of the migration VCN."
  value       = oci_core_vcn.main.id
}

output "subnet_ids" {
  description = "Map of subnet name to OCID."
  value = {
{% for subnet in network.subnets %}
    "{{ subnet.name }}" = oci_core_subnet.{{ subnet.resource_name }}.id
{% endfor %}
  }
}

output "instance_ids" {
  description = "Map of source VM name to migrated instance OCID."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = oci_core_instance.{{ c.resource_name }}.id
{% endfor %}
  }
}

output "instance_private_ips" {
  description = "Map of source VM name to private IP."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = oci_core_instance.{{ c.resource_name }}.private_ip
{% endfor %}
  }
}
