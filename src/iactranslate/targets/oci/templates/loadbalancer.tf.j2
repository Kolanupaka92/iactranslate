{% if network.load_balancers %}
# Generated by IaCTranslate — flexible Load Balancers fronting multi-instance
# tiers. One backend set + listener pair per port, since OCI backend sets are
# port-scoped (a listener on 443 forwarding to backend port 443 can't share a
# backend set with one on 80 -> 80).
{% for lb in network.load_balancers %}
resource "oci_load_balancer_load_balancer" "{{ lb.resource_name }}" {
  compartment_id = var.compartment_id
  display_name   = "{{ lb.name }}"
  shape          = "flexible"

  shape_details {
    minimum_bandwidth_in_mbps = 10
    maximum_bandwidth_in_mbps = 100
  }

  subnet_ids = [oci_core_subnet.{{ (network.subnets | selectattr("tier", "equalto", lb.subnet_tier) | list | first).resource_name }}.id]
  is_private = {{ "false" if lb.internet_facing else "true" }}
}

{% for listener in lb.listeners %}
resource "oci_load_balancer_backend_set" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  name             = "backend-{{ listener.listener_port }}"
  load_balancer_id = oci_load_balancer_load_balancer.{{ lb.resource_name }}.id
  policy           = "ROUND_ROBIN"

  health_checker {
    protocol = "TCP"
    port     = {{ listener.target_port }}
  }
}

{% for c in compute %}
{% if c.vm_name in lb.targets %}
resource "oci_load_balancer_backend" "{{ lb.resource_name }}_{{ listener.listener_port }}_{{ c.resource_name }}" {
  load_balancer_id = oci_load_balancer_load_balancer.{{ lb.resource_name }}.id
  backendset_name  = oci_load_balancer_backend_set.{{ lb.resource_name }}_{{ listener.listener_port }}.name
  ip_address       = oci_core_instance.{{ c.resource_name }}.private_ip
  port             = {{ listener.target_port }}
}

{% endif %}
{% endfor %}
resource "oci_load_balancer_listener" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  load_balancer_id        = oci_load_balancer_load_balancer.{{ lb.resource_name }}.id
  name                     = "listener-{{ listener.listener_port }}"
  default_backend_set_name = oci_load_balancer_backend_set.{{ lb.resource_name }}_{{ listener.listener_port }}.name
  port                     = {{ listener.listener_port }}
  protocol                 = "TCP"
}

{% endfor %}
{% endfor %}
{% endif %}
