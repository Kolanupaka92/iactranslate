{% set proto_num = {"tcp": "6", "udp": "17", "icmp": "1"} %}
# Generated by IaCTranslate — Network Security Groups (attached to instance
# VNICs, like an AWS security group or an Azure NSG-on-NIC).
{% for sg in network.security_groups %}
resource "oci_core_network_security_group" "{{ sg.resource_name }}" {
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.main.id
  display_name   = "${var.project_name}-{{ sg.name }}"
}

{% for rule in sg.ingress %}
{% set rule_idx = loop.index0 %}
{% for cidr in rule.cidr_blocks %}
resource "oci_core_network_security_group_security_rule" "{{ sg.resource_name }}_{{ rule_idx }}_{{ loop.index0 }}" {
  network_security_group_id = oci_core_network_security_group.{{ sg.resource_name }}.id
  direction                 = "INGRESS"
  protocol                  = "{{ proto_num.get(rule.protocol, "all") }}"
  source                    = "{{ cidr }}"
  source_type               = "CIDR_BLOCK"
  description               = "{{ rule.description }}"

{% if rule.protocol == "udp" %}
  udp_options {
    destination_port_range {
      min = {{ rule.from_port }}
      max = {{ rule.to_port }}
    }
  }
{% elif rule.protocol != "icmp" %}
  tcp_options {
    destination_port_range {
      min = {{ rule.from_port }}
      max = {{ rule.to_port }}
    }
  }
{% endif %}
}

{% endfor %}
{% endfor %}
{% endfor %}
