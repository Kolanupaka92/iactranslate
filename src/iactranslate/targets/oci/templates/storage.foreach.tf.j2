# Generated by IaCTranslate — additional block volumes, one resource over a map.
{% if volumes %}
# Keyed like the classic layout's labels: `oci_core_volume.data["app01_data_1"]`.
locals {
  data_volumes = {
{% for v in volumes %}
    "{{ v.resource_name }}" = { vm = "{{ v.instance_resource }}", name = "{{ v.vm_name }}", size = {{ v.size }}, lun = {{ v.lun }} }
{% endfor %}
  }
}

resource "oci_core_volume" "data" {
  for_each = local.data_volumes

  compartment_id      = var.compartment_id
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "${each.value.name}-data-${each.value.lun}"
  size_in_gbs         = each.value.size

  freeform_tags = merge(local.common_tags, {
    SourceVM = each.value.name
  })
}

resource "oci_core_volume_attachment" "data" {
  for_each = local.data_volumes

  attachment_type = "paravirtualized"
  instance_id     = oci_core_instance.vm[each.value.vm].id
  volume_id       = oci_core_volume.data[each.key].id
}
{% else %}
# No additional block volumes — all source VMs fit on a single boot volume.
{% endif %}
