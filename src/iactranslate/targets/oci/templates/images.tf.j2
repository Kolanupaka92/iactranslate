# Generated by IaCTranslate — image lookups (resolve the latest matching
# platform image at apply time; OCI image OCIDs are region-specific, so
# there's no static id to bake in the way GCP's public image families allow).
{% for key, ref in image_refs.items() %}
data "oci_core_images" "{{ ref.resource }}" {
  compartment_id           = var.compartment_id
  operating_system         = "{{ ref.operating_system }}"
  operating_system_version = "{{ ref.operating_system_version }}"
  sort_by                  = "TIMECREATED"
  sort_order               = "DESC"
}

{% endfor %}
