# Generated by IaCTranslate — additional block volumes.
{% if volumes %}
{% for v in volumes %}
resource "oci_core_volume" "{{ v.resource_name }}" {
  compartment_id      = var.compartment_id
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "{{ v.vm_name }}-data-{{ v.lun }}"
  size_in_gbs          = {{ v.size }}

  freeform_tags = {
    SourceVM = "{{ v.vm_name }}"
  }
}

resource "oci_core_volume_attachment" "{{ v.resource_name }}" {
  attachment_type = "paravirtualized"
  instance_id     = oci_core_instance.{{ v.instance_resource }}.id
  volume_id       = oci_core_volume.{{ v.resource_name }}.id
}

{% endfor %}
{% else %}
# No additional block volumes — all source VMs fit on a single boot volume.
{% endif %}
