# Generated by IaCTranslate — Compute instances, one resource over a per-VM map
# (the `for_each` layout, ADR 0073).
#
# Every machine is a row in `local.vms`; the resource below is written once.
# Keys are the classic layout's labels, so `oci_core_instance.vm["app01"]` is
# the classic `oci_core_instance.app01`. An instance fronted by a load balancer
# gets its public entry point there, not its own public IP.

locals {
  vms = {
{% for c in compute %}
    "{{ c.resource_name }}" = {
      name        = "{{ c.vm_name }}"
      slug        = "{{ vm_slug[c.vm_name] }}"
      windows     = {{ "true" if c.image_key.startswith('windows') else "false" }}
      shape       = "{{ c.instance_type.split('-')[0] }}"
      ocpus       = {{ c.instance_type.split('-')[1].split('x')[0] }}
      memory_gb   = {{ c.memory_gib }}
      subnet_id   = oci_core_subnet.{{ subnet_of[c.vm_name] }}.id
      nsg_id      = oci_core_network_security_group.{{ sg_resource[c.security_group] }}.id
      public_ip   = {{ "true" if c.vm_name in public_vm_names else "false" }}
      image_id    = data.oci_core_images.{{ image_refs[c.image_key].resource }}.images[0].id
      boot_gb     = {{ c.root_volume_gib }}
      tier        = "{{ c.tier.value }}"
      environment = "{{ c.environment.value }}"
    }
{% endfor %}
  }
}

resource "oci_core_instance" "vm" {
  for_each = local.vms

  compartment_id      = var.compartment_id
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = each.value.name
  shape               = each.value.shape

  shape_config {
    ocpus         = each.value.ocpus
    memory_in_gbs = each.value.memory_gb
  }

  create_vnic_details {
    subnet_id        = each.value.subnet_id
    nsg_ids          = [each.value.nsg_id]
    assign_public_ip = each.value.public_ip
    hostname_label   = substr(each.value.slug, 0, 63)
  }

  source_details {
    source_type             = "image"
    source_id               = each.value.image_id
    boot_volume_size_in_gbs = each.value.boot_gb
  }

  # Linux images take an SSH key; Windows images do not (null leaves it unset).
  metadata = each.value.windows ? null : {
    ssh_authorized_keys = var.admin_ssh_public_key
  }

  freeform_tags = merge(local.common_tags, {
    Tier        = each.value.tier
    Environment = each.value.environment
    SourceVM    = each.value.name
  })
}
