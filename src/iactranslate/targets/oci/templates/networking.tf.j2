# Generated by IaCTranslate — VCN, subnets, and routing.
resource "oci_core_vcn" "main" {
  compartment_id = var.compartment_id
  cidr_blocks    = ["{{ network.vpc_cidr }}"]
  display_name   = "${var.project_name}-vcn"
  # OCI dns_labels are alphanumeric, max 15 chars.
  dns_label      = substr("${replace(var.project_name, "-", "")}vcn", 0, 15)

  freeform_tags = {
    Project = var.project_name
  }
}

{% if network.internet_gateway %}
resource "oci_core_internet_gateway" "main" {
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.main.id
  display_name   = "${var.project_name}-igw"
  enabled        = true
}

resource "oci_core_route_table" "public" {
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.main.id
  display_name   = "${var.project_name}-public-rt"

  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_internet_gateway.main.id
  }
}

{% endif %}
{% if network.nat_gateway %}
resource "oci_core_nat_gateway" "main" {
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.main.id
  display_name   = "${var.project_name}-nat"
}

resource "oci_core_route_table" "private" {
  compartment_id = var.compartment_id
  vcn_id         = oci_core_vcn.main.id
  display_name   = "${var.project_name}-private-rt"

  route_rules {
    destination       = "0.0.0.0/0"
    network_entity_id = oci_core_nat_gateway.main.id
  }
}

{% endif %}
{% for subnet in network.subnets %}
resource "oci_core_subnet" "{{ subnet.resource_name }}" {
  compartment_id             = var.compartment_id
  vcn_id                     = oci_core_vcn.main.id
  cidr_block                 = "{{ subnet.cidr }}"
  display_name               = "${var.project_name}-{{ subnet.name }}"
  dns_label                  = substr("{{ subnet.resource_name | replace('_', '') }}", 0, 15)
{% if subnet.tier.value == "public" %}
  prohibit_public_ip_on_vnic = false
{% if network.internet_gateway %}
  route_table_id             = oci_core_route_table.public.id
{% endif %}
{% else %}
  prohibit_public_ip_on_vnic = true
{% if network.nat_gateway %}
  route_table_id             = oci_core_route_table.private.id
{% endif %}
{% endif %}
}

{% endfor %}
# OCI VCN subnets are regional (not AZ-scoped like AWS/Azure/GCP); instances
# are placed across availability domains directly (see compute.tf). Most OCI
# regions offer 1-3 ADs — every instance below uses the first, which is always
# valid; edit `availability_domain` per instance for multi-AD placement where
# your region/tenancy supports it.
