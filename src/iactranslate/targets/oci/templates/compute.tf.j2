# Generated by IaCTranslate — Compute instances (one per source VM).
# An instance fronted by a load balancer (loadbalancer.tf) gets its public
# entry point there, not its own public IP.
{% for c in compute %}
resource "oci_core_instance" "{{ c.resource_name }}" {
  compartment_id      = var.compartment_id
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
  display_name        = "{{ c.vm_name }}"
  shape                = "{{ c.instance_type.split('-')[0] }}"


  shape_config {
    ocpus         = {{ c.vcpu }}
    memory_in_gbs = {{ c.memory_gib }}
  }

  create_vnic_details {
    subnet_id        = oci_core_subnet.{{ subnet_of[c.vm_name] }}.id
    nsg_ids          = [oci_core_network_security_group.{{ sg_resource[c.security_group] }}.id]
{% if c.subnet_tier == SubnetTier.PUBLIC and c.vm_name not in fronted_vm_names %}
    assign_public_ip = true
{% else %}
    assign_public_ip = false
{% endif %}
    hostname_label   = substr("{{ vm_slug[c.vm_name] }}", 0, 63)
  }

  source_details {
    source_type             = "image"
    source_id               = data.oci_core_images.{{ image_refs[c.image_key].resource }}.images[0].id
    boot_volume_size_in_gbs = {{ c.root_volume_gib }}
  }

{% if not c.image_key.startswith('windows') %}
  metadata = {
    ssh_authorized_keys = var.admin_ssh_public_key
  }
{% endif %}

  freeform_tags = {
    Tier        = "{{ c.tier.value }}"
    Environment = "{{ c.environment.value }}"
    SourceVM    = "{{ c.vm_name }}"
  }
}

{% endfor %}
