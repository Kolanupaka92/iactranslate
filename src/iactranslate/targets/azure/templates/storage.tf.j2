# Generated by IaCTranslate — additional managed data disks.
{% if volumes %}
{% for v in volumes %}
resource "azurerm_managed_disk" "{{ v.resource_name }}" {
  name                 = "{{ v.vm_name }}-data-{{ v.lun }}"
  resource_group_name  = azurerm_resource_group.main.name
  location             = azurerm_resource_group.main.location
  storage_account_type = "StandardSSD_LRS"
  create_option        = "Empty"
  disk_size_gb         = {{ v.size }}

  tags = {
    SourceVM = "{{ v.vm_name }}"
  }
}

resource "azurerm_virtual_machine_data_disk_attachment" "{{ v.resource_name }}" {
  managed_disk_id    = azurerm_managed_disk.{{ v.resource_name }}.id
{% if v.is_windows %}
  virtual_machine_id = azurerm_windows_virtual_machine.{{ v.instance_resource }}.id
{% else %}
  virtual_machine_id = azurerm_linux_virtual_machine.{{ v.instance_resource }}.id
{% endif %}
  lun                = {{ v.lun }}
  caching            = "ReadWrite"
}

{% endfor %}
{% else %}
# No additional data disks — all source VMs fit on a single OS disk.
{% endif %}
