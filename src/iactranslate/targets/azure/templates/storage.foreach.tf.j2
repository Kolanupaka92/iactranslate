# Generated by IaCTranslate — additional managed data disks, one resource over a map.
{% if volumes %}
# Keyed like the classic layout's labels: `azurerm_managed_disk.data["app01_data_1"]`.
locals {
  data_volumes = {
{% for v in volumes %}
    "{{ v.resource_name }}" = { vm = "{{ v.instance_resource }}", name = "{{ v.vm_name }}", size = {{ v.size }}, lun = {{ v.lun }} }
{% endfor %}
  }

  # A disk attaches to a Windows or a Linux VM — two resource types. One merged
  # lookup, because `windows ? windows_vm[k] : linux_vm[k]` evaluates both
  # branches, and the unselected index does not exist.
  vm_ids = merge(
    { for k, vm in azurerm_windows_virtual_machine.vm : k => vm.id },
    { for k, vm in azurerm_linux_virtual_machine.vm : k => vm.id },
  )
}

resource "azurerm_managed_disk" "data" {
  for_each = local.data_volumes

  name                 = "${each.value.name}-data-${each.value.lun}"
  resource_group_name  = azurerm_resource_group.main.name
  location             = azurerm_resource_group.main.location
  storage_account_type = "StandardSSD_LRS"
  create_option        = "Empty"
  disk_size_gb         = each.value.size

  tags = merge(local.common_tags, {
    SourceVM = each.value.name
  })
}

resource "azurerm_virtual_machine_data_disk_attachment" "data" {
  for_each = local.data_volumes

  managed_disk_id    = azurerm_managed_disk.data[each.key].id
  virtual_machine_id = local.vm_ids[each.value.vm]
  lun                = each.value.lun
  caching            = "ReadWrite"
}
{% else %}
# No additional data disks — all source VMs fit on a single OS disk.
{% endif %}
