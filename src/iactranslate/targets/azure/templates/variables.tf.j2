}

variable "project_name" {
  description = "Project name used as a resource name prefix and tag."
  type        = string
  default     = "{{ project }}"
}

variable "resource_group_name" {
  description = "Resource group to create resources in."
  type        = string
  default     = "{{ project }}-rg"
}

variable "admin_username" {
  description = "Admin username for the migrated VMs."
