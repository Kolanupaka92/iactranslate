# Generated by IaCTranslate.
variable "location" {
  description = "Azure region to deploy into."
  type        = string
  default     = "{{ region }}"
}

variable "project_name" {
  description = "Project name used as a resource name prefix and tag."
  type        = string
  default     = "{{ project }}"
}

variable "resource_group_name" {
  description = "Resource group to create resources in."
  type        = string
  default     = "{{ project }}-rg"
}

variable "admin_username" {
  description = "Admin username for the migrated VMs."
  type        = string
  default     = "azureadmin"
}

variable "admin_ssh_public_key" {
  description = "SSH public key for Linux VMs. Set before `terraform apply`."
  type        = string
  default     = "ssh-rsa REPLACE_ME"
}

variable "admin_password" {
  description = "Admin password for Windows VMs. Set via TF_VAR_admin_password / a secret store."
  type        = string
  sensitive   = true
  default     = "REPLACE_ME_Str0ng!Pass"
}

variable "source_image_ids" {
  description = <<-EOT
    Managed image / Shared Image Gallery ID per logical OS key. IaCTranslate
    cannot know your images, so fill these in before `terraform apply`. Keys
    correspond to the OS detected on each source VM.
  EOT
  type = map(string)
  default = {
{% for key in image_keys %}
    "{{ key }}" = "REPLACE_ME"
{% endfor %}
  }
}
