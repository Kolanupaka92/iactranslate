{% if hybrid and hybrid.required %}
# Generated by IaCTranslate — hybrid connectivity to networks that are NOT migrating.
#
# Derived from observed network flows: addresses the estate actually talks to
# that are absent from the inventory, so nothing is moving them.
{% for note in hybrid.notes %}
#
# {{ note }}
{% endfor %}
{% if hybrid.conflicts %}

# ---------------------------------------------------------------------------
# STOP. These on-prem networks overlap this VNet's own range ({{ hybrid.vpc_cidr }}):
{% for net in hybrid.conflicts %}
#   {{ net.cidr }}  ({{ net.connections }} connections from {{ net.dependent_workloads | length }} workload(s))
{% endfor %}
#
# No route to them can exist while the VNet claims the same addresses. This is
# not fixable with routing — the landing zone CIDR must be reallocated, which
# re-plans every subnet. Do it before cutover. Nothing is generated for these.
# ---------------------------------------------------------------------------
{% endif %}
{% if hybrid.routable %}

# The local network gateway describes the customer's own edge router. Its public
# address is a property of that device and cannot come from an inventory, so it
# is declared with NO default: `terraform plan` fails until a human supplies it.
variable "on_prem_gateway_ip" {
  type        = string
  description = "Public IP of the on-premises VPN endpoint (from the network team)"
}

locals {
  on_prem_cidrs = [
{% for net in hybrid.routable %}
    "{{ net.cidr }}", # {{ net.connections }} connections, ports {{ net.ports | join(", ") }}
{% endfor %}
  ]
}

# A gateway subnet is mandatory and must be named exactly "GatewaySubnet".
# Carved from the top of the VNet range so it cannot collide with the workload
# subnets this plan already allocated.
resource "azurerm_subnet" "gateway" {
  name                 = "GatewaySubnet"
  resource_group_name  = azurerm_resource_group.main.name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = [cidrsubnet("{{ hybrid.vpc_cidr }}", 8, 255)]
}

resource "azurerm_public_ip" "vpn" {
  name                = "${var.project_name}-vpn-pip"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  allocation_method   = "Static"
  sku                 = "Standard"
}

# NOTE: this resource bills from creation (VpnGw1 is roughly USD 140/month) and
# takes 30-45 minutes to provision. It is generated because the estate provably
# needs it, not because it is free.
resource "azurerm_virtual_network_gateway" "main" {
  name                = "${var.project_name}-vpngw"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  type                = "Vpn"
  vpn_type            = "RouteBased"
  sku                 = "VpnGw1"

  ip_configuration {
    name                          = "vnetGatewayConfig"
    public_ip_address_id          = azurerm_public_ip.vpn.id
    private_ip_address_allocation = "Dynamic"
    subnet_id                     = azurerm_subnet.gateway.id
  }
}

resource "azurerm_local_network_gateway" "on_prem" {
  name                = "${var.project_name}-on-prem"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  gateway_address     = var.on_prem_gateway_ip
  address_space       = local.on_prem_cidrs
}

resource "azurerm_virtual_network_gateway_connection" "on_prem" {
  name                       = "${var.project_name}-to-on-prem"
  location                   = azurerm_resource_group.main.location
  resource_group_name        = azurerm_resource_group.main.name
  type                       = "IPsec"
  virtual_network_gateway_id = azurerm_virtual_network_gateway.main.id
  local_network_gateway_id   = azurerm_local_network_gateway.on_prem.id
  shared_key                 = var.on_prem_shared_key
}

# A pre-shared key is a secret. It is a variable with no default so it is never
# written into generated source, and it is marked sensitive so it stays out of
# plan output and logs. Supply it via TF_VAR_on_prem_shared_key or your secret
# manager — not terraform.tfvars.
variable "on_prem_shared_key" {
  type        = string
  description = "IPsec pre-shared key for the on-premises tunnel"
  sensitive   = true
}

# ExpressRoute is deliberately NOT generated: it is a physical circuit ordered
# from a connectivity provider with a lead time in weeks, and the resource bills
# from the moment it applies.
{% endif %}
{% endif %}
