{% if network.load_balancers %}
# Generated by IaCTranslate — Standard Load Balancers fronting multi-instance tiers.
{% for lb in network.load_balancers %}
{% if lb.internet_facing %}
resource "azurerm_public_ip" "{{ lb.resource_name }}" {
  name                = "{{ lb.name }}-pip"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  allocation_method   = "Static"
  sku                 = "Standard"
}

{% endif %}
resource "azurerm_lb" "{{ lb.resource_name }}" {
  name                = "{{ lb.name }}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  sku                 = "Standard"

  frontend_ip_configuration {
    name = "frontend"
{% if lb.internet_facing %}
    public_ip_address_id = azurerm_public_ip.{{ lb.resource_name }}.id
{% else %}
    subnet_id                    = azurerm_subnet.{{ (network.subnets | selectattr("tier", "equalto", lb.subnet_tier) | list | first).resource_name }}.id
    private_ip_address_allocation = "Dynamic"
{% endif %}
  }
}

resource "azurerm_lb_backend_address_pool" "{{ lb.resource_name }}" {
  loadbalancer_id = azurerm_lb.{{ lb.resource_name }}.id
  name            = "backendPool"
}

{% for listener in lb.listeners %}
resource "azurerm_lb_probe" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  loadbalancer_id = azurerm_lb.{{ lb.resource_name }}.id
  name            = "probe{{ listener.listener_port }}"
  protocol        = "Tcp"
  port            = {{ listener.target_port }}
}

resource "azurerm_lb_rule" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  loadbalancer_id                = azurerm_lb.{{ lb.resource_name }}.id
  name                           = "rule{{ listener.listener_port }}"
  protocol                       = "Tcp"
  frontend_port                  = {{ listener.listener_port }}
  backend_port                   = {{ listener.target_port }}
  frontend_ip_configuration_name = "frontend"
  backend_address_pool_ids       = [azurerm_lb_backend_address_pool.{{ lb.resource_name }}.id]
  probe_id                       = azurerm_lb_probe.{{ lb.resource_name }}_{{ listener.listener_port }}.id
}

{% endfor %}
{% endfor %}
{% endif %}
