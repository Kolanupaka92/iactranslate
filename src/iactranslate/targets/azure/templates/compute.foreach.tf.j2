# Generated by IaCTranslate — public IPs, NICs and VMs, one resource each over
# a per-VM map (the `for_each` layout, ADR 0073).
#
# Every machine is a row in `local.vms`; each resource below is written once.
# Keys are the classic layout's labels, so `azurerm_linux_virtual_machine.vm["app01"]`
# is the classic `azurerm_linux_virtual_machine.app01`. An instance fronted by
# a load balancer gets its public entry point there, not its own public IP.

locals {
  vms = {
{% for c in compute %}
    "{{ c.resource_name }}" = {
      name        = "{{ c.vm_name }}"
      slug        = "{{ vm_slug[c.vm_name] }}"
      windows     = {{ "true" if c.image_key.startswith('windows') else "false" }}
      size        = "{{ c.instance_type }}"
      root_gib    = {{ c.root_volume_gib }}
      publisher   = "{{ image_refs[c.image_key].publisher }}"
      offer       = "{{ image_refs[c.image_key].offer }}"
      sku         = "{{ image_refs[c.image_key].sku }}"
      subnet_id   = azurerm_subnet.{{ subnet_of[c.vm_name] }}.id
      nsg_id      = azurerm_network_security_group.{{ sg_resource[c.security_group] }}.id
      public_ip   = {{ "true" if (c.subnet_tier == SubnetTier.PUBLIC and c.vm_name not in fronted_vm_names) else "false" }}
      lb_pool     = {{ ("azurerm_lb_backend_address_pool." ~ lb_resource_of[c.vm_name] ~ ".id") if c.vm_name in fronted_vm_names else "null" }}
{% if identity_roles %}
      identity_id = azurerm_user_assigned_identity.{{ c.tier.value }}.id
{% endif %}
      tier        = "{{ c.tier.value }}"
      environment = "{{ c.environment.value }}"
    }
{% endfor %}
  }

  windows_vms = { for k, v in local.vms : k => v if v.windows }
  linux_vms   = { for k, v in local.vms : k => v if !v.windows }
  public_vms  = { for k, v in local.vms : k => v if v.public_ip }
  pooled_vms  = { for k, v in local.vms : k => v if v.lb_pool != null }
}

resource "azurerm_public_ip" "vm" {
  for_each = local.public_vms

  name                = "${each.value.slug}-pip"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  allocation_method   = "Static"
  sku                 = "Standard"

  tags = merge(local.common_tags, {
    SourceVM = each.value.name
  })
}

resource "azurerm_network_interface" "vm" {
  for_each = local.vms

  name                = "${each.value.slug}-nic"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location

  ip_configuration {
    name                          = "internal"
    subnet_id                     = each.value.subnet_id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = each.value.public_ip ? azurerm_public_ip.vm[each.key].id : null
  }

  tags = merge(local.common_tags, {
    SourceVM = each.value.name
  })
}

resource "azurerm_network_interface_security_group_association" "vm" {
  for_each = local.vms

  network_interface_id      = azurerm_network_interface.vm[each.key].id
  network_security_group_id = each.value.nsg_id
}

resource "azurerm_network_interface_backend_address_pool_association" "vm" {
  for_each = local.pooled_vms

  network_interface_id    = azurerm_network_interface.vm[each.key].id
  ip_configuration_name   = "internal"
  backend_address_pool_id = each.value.lb_pool
}

resource "azurerm_windows_virtual_machine" "vm" {
  for_each = local.windows_vms

{% if identity_roles %}
  identity {
    type         = "UserAssigned"
    identity_ids = [each.value.identity_id]
  }
{% endif %}
  name                  = each.value.slug
  resource_group_name   = azurerm_resource_group.main.name
  location              = azurerm_resource_group.main.location
  size                  = each.value.size
  admin_username        = var.admin_username
  admin_password        = var.admin_password
  network_interface_ids = [azurerm_network_interface.vm[each.key].id]

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = each.value.root_gib
{% if kms_key_id %}
    # Managed disks are always encrypted at rest with a platform-managed key;
    # this replaces it with the customer's own, via a disk encryption set.
    disk_encryption_set_id = "{{ kms_key_id }}"
{% endif %}
  }

  source_image_reference {
    publisher = each.value.publisher
    offer     = each.value.offer
    sku       = each.value.sku
    version   = "latest"
  }

  tags = merge(local.common_tags, {
    Name        = each.value.name
    Tier        = each.value.tier
    Environment = each.value.environment
    SourceVM    = each.value.name
  })
}

resource "azurerm_linux_virtual_machine" "vm" {
  for_each = local.linux_vms

  name                  = each.value.slug
  resource_group_name   = azurerm_resource_group.main.name
  location              = azurerm_resource_group.main.location
  size                  = each.value.size
  admin_username        = var.admin_username
  network_interface_ids = [azurerm_network_interface.vm[each.key].id]

  admin_ssh_key {
    username   = var.admin_username
    public_key = var.admin_ssh_public_key
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = each.value.root_gib
{% if kms_key_id %}
    # Managed disks are always encrypted at rest with a platform-managed key;
    # this replaces it with the customer's own, via a disk encryption set.
    disk_encryption_set_id = "{{ kms_key_id }}"
{% endif %}
  }

  source_image_reference {
    publisher = each.value.publisher
    offer     = each.value.offer
    sku       = each.value.sku
    version   = "latest"
  }

  tags = merge(local.common_tags, {
    Name        = each.value.name
    Tier        = each.value.tier
    Environment = each.value.environment
    SourceVM    = each.value.name
  })
}
