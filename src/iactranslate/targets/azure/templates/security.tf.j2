# Generated by IaCTranslate — network security groups.
{% for sg in network.security_groups %}
resource "azurerm_network_security_group" "{{ sg.resource_name }}" {
  name                = "${var.project_name}-{{ sg.name }}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

{% for rule in sg.ingress %}
  security_rule {
    name                       = "{{ rule.description | replace(' ', '-') }}"
    priority                   = {{ 100 + loop.index0 * 10 }}
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "{{ rule.protocol | capitalize }}"
    source_port_range          = "*"
    destination_port_range     = "{{ rule.from_port }}{% if rule.to_port != rule.from_port %}-{{ rule.to_port }}{% endif %}"
    source_address_prefixes    = [{% for cidr in rule.cidr_blocks %}"{{ cidr }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    destination_address_prefix = "*"
  }

{% endfor %}
  tags = {
    Project = var.project_name
  }
}

{% endfor %}
