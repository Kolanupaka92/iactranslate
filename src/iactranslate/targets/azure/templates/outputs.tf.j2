# Generated by IaCTranslate — useful outputs.
output "resource_group_name" {
  description = "Name of the migration resource group."
  value       = azurerm_resource_group.main.name
}

output "vnet_id" {
  description = "ID of the migration virtual network."
  value       = azurerm_virtual_network.main.id
}

output "vm_ids" {
  description = "Map of source VM name to migrated VM ID."
  value = {
{% for c in compute %}
{% if c.image_key.startswith('windows') %}
    "{{ c.vm_name }}" = azurerm_windows_virtual_machine.{{ c.resource_name }}.id
{% else %}
    "{{ c.vm_name }}" = azurerm_linux_virtual_machine.{{ c.resource_name }}.id
{% endif %}
{% endfor %}
  }
}

output "vm_private_ips" {
  description = "Map of source VM name to private IP."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = azurerm_network_interface.{{ c.resource_name }}.private_ip_address
{% endfor %}
  }
}
