# Generated by IaCTranslate — resource group, VNet, subnets.
resource "azurerm_resource_group" "main" {
  name     = var.resource_group_name
  location = var.location

  tags = merge(local.common_tags, {
    Project   = var.project_name
    ManagedBy = "IaCTranslate"
  })
}

resource "azurerm_virtual_network" "main" {
  name                = "${var.project_name}-vnet"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  address_space       = ["{{ network.vpc_cidr }}"]

  tags = merge(local.common_tags, {
    Project = var.project_name
  })
}

{% for subnet in network.subnets %}
resource "azurerm_subnet" "{{ subnet.resource_name }}" {
  name                 = "${var.project_name}-{{ subnet.name }}"
  resource_group_name  = azurerm_resource_group.main.name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = ["{{ subnet.cidr }}"]
}

{% endfor %}
{% if network.nat_gateway %}
# Private machines' way out to the internet. Without it they rely on Azure's
# default outbound access, which Microsoft is retiring (ADR 0100). Machines in
# public subnets keep their own address or the public load balancer's.
resource "azurerm_public_ip" "nat" {
  name                = "${var.project_name}-nat-ip"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  allocation_method   = "Static"
  sku                 = "Standard"
  tags                = merge(local.common_tags, {})
}

resource "azurerm_nat_gateway" "main" {
  name                = "${var.project_name}-nat"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  sku_name            = "Standard"
  tags                = merge(local.common_tags, {})
}

resource "azurerm_nat_gateway_public_ip_association" "main" {
  nat_gateway_id       = azurerm_nat_gateway.main.id
  public_ip_address_id = azurerm_public_ip.nat.id
}
{% for subnet in network.subnets if subnet.tier == SubnetTier.PRIVATE %}

resource "azurerm_subnet_nat_gateway_association" "{{ subnet.resource_name }}" {
  subnet_id      = azurerm_subnet.{{ subnet.resource_name }}.id
  nat_gateway_id = azurerm_nat_gateway.main.id
}
{% endfor %}
{% endif %}
