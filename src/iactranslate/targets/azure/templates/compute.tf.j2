# Generated by IaCTranslate — public IPs, NICs, and VMs (one per source VM).
{% for c in compute %}
{% if c.subnet_tier == SubnetTier.PUBLIC %}
resource "azurerm_public_ip" "{{ c.resource_name }}" {
  name                = "{{ c.vm_name }}-pip"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  allocation_method   = "Static"
  sku                 = "Standard"

  tags = {
    SourceVM = "{{ c.vm_name }}"
  }
}

{% endif %}
resource "azurerm_network_interface" "{{ c.resource_name }}" {
  name                = "{{ c.vm_name }}-nic"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.{{ subnet_of[c.vm_name] }}.id
    private_ip_address_allocation = "Dynamic"
{% if c.subnet_tier == SubnetTier.PUBLIC %}
    public_ip_address_id          = azurerm_public_ip.{{ c.resource_name }}.id
{% endif %}
  }

  tags = {
    SourceVM = "{{ c.vm_name }}"
  }
}

resource "azurerm_network_interface_security_group_association" "{{ c.resource_name }}" {
  network_interface_id      = azurerm_network_interface.{{ c.resource_name }}.id
  network_security_group_id = azurerm_network_security_group.{{ sg_resource[c.security_group] }}.id
}

{% if c.image_key.startswith('windows') %}
resource "azurerm_windows_virtual_machine" "{{ c.resource_name }}" {
  name                  = "{{ c.vm_name }}"
  resource_group_name   = azurerm_resource_group.main.name
  location              = azurerm_resource_group.main.location
  size                  = "{{ c.instance_type }}"
  admin_username        = var.admin_username
  admin_password        = var.admin_password
  network_interface_ids = [azurerm_network_interface.{{ c.resource_name }}.id]

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = {{ c.root_volume_gib }}
  }

  source_image_reference {
    publisher = "{{ image_refs[c.image_key].publisher }}"
    offer     = "{{ image_refs[c.image_key].offer }}"
    sku       = "{{ image_refs[c.image_key].sku }}"
    version   = "latest"
  }

  tags = {
    Name        = "{{ c.vm_name }}"
    Tier        = "{{ c.tier.value }}"
    Environment = "{{ c.environment.value }}"
    SourceVM    = "{{ c.vm_name }}"
  }
}
{% else %}
resource "azurerm_linux_virtual_machine" "{{ c.resource_name }}" {
  name                  = "{{ c.vm_name }}"
  resource_group_name   = azurerm_resource_group.main.name
  location              = azurerm_resource_group.main.location
  size                  = "{{ c.instance_type }}"
  admin_username        = var.admin_username
  network_interface_ids = [azurerm_network_interface.{{ c.resource_name }}.id]

  admin_ssh_key {
    username   = var.admin_username
    public_key = var.admin_ssh_public_key
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = {{ c.root_volume_gib }}
  }

  source_image_reference {
    publisher = "{{ image_refs[c.image_key].publisher }}"
    offer     = "{{ image_refs[c.image_key].offer }}"
    sku       = "{{ image_refs[c.image_key].sku }}"
    version   = "latest"
  }

  tags = {
    Name        = "{{ c.vm_name }}"
    Tier        = "{{ c.tier.value }}"
    Environment = "{{ c.environment.value }}"
    SourceVM    = "{{ c.vm_name }}"
  }
}
{% endif %}

{% endfor %}
