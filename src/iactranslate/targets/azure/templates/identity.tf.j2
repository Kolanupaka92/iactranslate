{% if identity_roles %}
# Generated by IaCTranslate — workload identity.
#
# One user-assigned managed identity per tier, with NO role assignments.
# Grant access explicitly:
#
#   resource "azurerm_role_assignment" "app_reads_kv" {
#     scope                = azurerm_key_vault.example.id
#     role_definition_name = "Key Vault Secrets User"
#     principal_id         = azurerm_user_assigned_identity.app.principal_id
#   }
{% for tier in identity_roles %}

resource "azurerm_user_assigned_identity" "{{ tier }}" {
  name                = "${var.project_name}-{{ tier }}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  tags                = merge(local.common_tags, {})
}
{% endfor %}
{% endif %}
