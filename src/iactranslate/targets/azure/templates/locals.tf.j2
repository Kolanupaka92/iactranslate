# Generated by IaCTranslate.
# Tags mandated by the customer's cloud governance, merged into every resource.
# Neither the azurerm nor the oci provider offers a default-tags block, so this
# has to be applied per resource rather than once at the provider.
locals {
  common_tags = {
    Project   = var.project_name
    ManagedBy = "IaCTranslate"
{% for key, value in mandated_tags.items() %}
    {{ "%-9s"|format(key) }} = "{{ value }}"
{% endfor %}
  }
}
