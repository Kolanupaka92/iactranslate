# Generated by IaCTranslate — Compute Engine instances (one per source VM).
{% for c in compute %}
resource "google_compute_instance" "{{ c.resource_name }}" {
{% if identity_roles %}
  service_account {
    email  = google_service_account.{{ c.tier.value }}.email
    # Scopes are legacy; cloud-platform defers the decision to IAM,
    # which is where the service account's (currently empty) roles live.
    scopes = ["cloud-platform"]
  }
{% endif %}
  name         = "{{ vm_slug[c.vm_name] }}"
  machine_type = "{{ c.instance_type }}"
  zone         = var.zone
  tags         = ["{{ c.security_group }}"]

  boot_disk {
    initialize_params {
      image = "{{ image_refs[c.image_key].image }}"
      size  = {{ c.root_volume_gib }}
      type  = "pd-balanced"
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.{{ subnet_of[c.vm_name] }}.id
{% if c.subnet_tier == SubnetTier.PUBLIC and c.vm_name not in fronted_vm_names %}
    access_config {
      # Ephemeral external IP.
    }
{% endif %}
  }

  labels = {
    tier        = "{{ c.tier.value }}"
    environment = "{{ c.environment.value }}"
    source_vm   = "{{ vm_slug[c.vm_name] }}"
  }
}

{% endfor %}
