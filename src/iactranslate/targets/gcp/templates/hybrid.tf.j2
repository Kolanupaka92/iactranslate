{% if hybrid and hybrid.required %}
# Generated by IaCTranslate — hybrid connectivity to networks that are NOT migrating.
#
# Derived from observed network flows: addresses the estate actually talks to
# that are absent from the inventory, so nothing is moving them.
{% for note in hybrid.notes %}
#
# {{ note }}
{% endfor %}
{% if hybrid.conflicts %}

# ---------------------------------------------------------------------------
# STOP. These on-prem networks overlap this VPC's own range ({{ hybrid.vpc_cidr }}):
{% for net in hybrid.conflicts %}
#   {{ net.cidr }}  ({{ net.connections }} connections from {{ net.dependent_workloads | length }} workload(s))
{% endfor %}
#
# No route to them can exist while the VPC claims the same addresses. The
# landing zone CIDR must be reallocated before cutover. Nothing is generated
# for these ranges, because nothing would work.
# ---------------------------------------------------------------------------
{% endif %}
{% if hybrid.routable %}

variable "on_prem_gateway_ip" {
  type        = string
  description = "Public IP of the on-premises VPN endpoint (from the network team)"
}

variable "on_prem_shared_key" {
  type        = string
  description = "IKE pre-shared key for the on-premises tunnel"
  sensitive   = true
}

locals {
  on_prem_cidrs = [
{% for net in hybrid.routable %}
    "{{ net.cidr }}", # {{ net.connections }} connections, ports {{ net.ports | join(", ") }}
{% endfor %}
  ]
}

resource "google_compute_ha_vpn_gateway" "main" {
  name    = "${var.project_name}-vpn-gw"
  network = google_compute_network.main.id
  region  = var.region
}

resource "google_compute_external_vpn_gateway" "on_prem" {
  name            = "${var.project_name}-on-prem-gw"
  redundancy_type = "SINGLE_IP_INTERNALLY_REDUNDANT"

  interface {
    id         = 0
    ip_address = var.on_prem_gateway_ip
  }
}

resource "google_compute_router" "vpn" {
  name    = "${var.project_name}-vpn-router"
  network = google_compute_network.main.id
  region  = var.region

  bgp {
    asn = 64514
  }
}

resource "google_compute_vpn_tunnel" "on_prem" {
  name                            = "${var.project_name}-to-on-prem"
  region                          = var.region
  vpn_gateway                     = google_compute_ha_vpn_gateway.main.id
  peer_external_gateway           = google_compute_external_vpn_gateway.on_prem.id
  peer_external_gateway_interface = 0
  shared_secret                   = var.on_prem_shared_key
  router                          = google_compute_router.vpn.id
  vpn_gateway_interface           = 0
}

# Without these the tunnel is up and nothing uses it — the failure that looks
# like success.
resource "google_compute_route" "to_on_prem" {
  for_each            = toset(local.on_prem_cidrs)
  name                = "${var.project_name}-on-prem-${replace(replace(each.value, ".", "-"), "/", "-")}"
  network             = google_compute_network.main.name
  dest_range          = each.value
  next_hop_vpn_tunnel = google_compute_vpn_tunnel.on_prem.id
  priority            = 1000
}

# Cloud Interconnect is deliberately NOT generated: it is a physical circuit
# ordered from a partner, with a lead time in weeks and a port that bills.
{% endif %}
{% endif %}
