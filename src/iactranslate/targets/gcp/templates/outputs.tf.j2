# Generated by IaCTranslate — useful outputs.
output "network_id" {
  description = "ID of the migration VPC network."
  value       = google_compute_network.main.id
}

output "subnet_ids" {
  description = "Map of subnet name to ID."
  value = {
{% for subnet in network.subnets %}
    "{{ subnet.name }}" = google_compute_subnetwork.{{ subnet.resource_name }}.id
{% endfor %}
  }
}

output "instance_self_links" {
  description = "Map of source VM name to migrated instance self_link."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = google_compute_instance.{{ c.resource_name }}.self_link
{% endfor %}
  }
}

output "instance_internal_ips" {
  description = "Map of source VM name to internal IP."
  value = {
{% for c in compute %}
    "{{ c.vm_name }}" = google_compute_instance.{{ c.resource_name }}.network_interface[0].network_ip
{% endfor %}
  }
}
