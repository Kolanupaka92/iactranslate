# Generated by IaCTranslate — additional persistent data disks.
{% if volumes %}
{% for v in volumes %}
resource "google_compute_disk" "{{ v.resource_name }}" {
  name = "{{ vm_slug[v.vm_name] }}-data-{{ v.lun }}"
  zone = var.zone
  size = {{ v.size }}
  type = "pd-balanced"

  labels = {
    source_vm = "{{ vm_slug[v.vm_name] }}"
  }
}

resource "google_compute_attached_disk" "{{ v.resource_name }}" {
  disk     = google_compute_disk.{{ v.resource_name }}.id
  instance = google_compute_instance.{{ v.instance_resource }}.id
}

{% endfor %}
{% else %}
# No additional data disks — all source VMs fit on a single boot disk.
{% endif %}
