# Generated by IaCTranslate — firewall rules (scoped by network tag).
{% for sg in network.security_groups %}
{% set ns = namespace(cidrs=[]) %}
{% for rule in sg.ingress %}
{% for c in rule.cidr_blocks %}
{% if c not in ns.cidrs %}{% set ns.cidrs = ns.cidrs + [c] %}{% endif %}
{% endfor %}
{% endfor %}
resource "google_compute_firewall" "{{ sg.resource_name }}" {
  name    = "${var.project_name}-{{ sg.name }}"
  network = google_compute_network.main.id

{% for rule in sg.ingress %}
  allow {
    protocol = "{{ rule.protocol }}"
    ports    = ["{{ rule.from_port }}{% if rule.to_port != rule.from_port %}-{{ rule.to_port }}{% endif %}"]
  }
{% endfor %}

  source_ranges = [{% for c in ns.cidrs %}"{{ c }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  target_tags   = ["{{ sg.name }}"]
}

{% endfor %}
