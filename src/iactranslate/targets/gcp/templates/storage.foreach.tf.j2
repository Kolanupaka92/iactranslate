# Generated by IaCTranslate — additional persistent data disks, one resource over a map.
{% if volumes %}
# Keyed like the classic layout's labels: `google_compute_disk.data["app01_data_1"]`.
locals {
  data_volumes = {
{% for v in volumes %}
    "{{ v.resource_name }}" = { vm = "{{ v.instance_resource }}", slug = "{{ vm_slug[v.vm_name] }}", size = {{ v.size }}, lun = {{ v.lun }} }
{% endfor %}
  }
}

resource "google_compute_disk" "data" {
  for_each = local.data_volumes

  name = "${each.value.slug}-data-${each.value.lun}"
  zone = var.zone
  size = each.value.size
  type = "pd-balanced"

  labels = {
    source_vm = each.value.slug
  }
}

resource "google_compute_attached_disk" "data" {
  for_each = local.data_volumes

  disk     = google_compute_disk.data[each.key].id
  instance = google_compute_instance.vm[each.value.vm].id
}
{% else %}
# No additional data disks — all source VMs fit on a single boot disk.
{% endif %}
