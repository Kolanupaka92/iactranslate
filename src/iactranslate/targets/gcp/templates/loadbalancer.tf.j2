{% if network.load_balancers %}
# Generated by IaCTranslate — load balancers fronting multi-instance tiers.
#
# GCP's external (Network) Load Balancer and internal Load Balancer are genuinely
# different resource families, not one resource with a scheme flag: external uses
# a target pool (raw instances, no group needed); internal uses a regional backend
# service, which requires an instance group even for unmanaged instances.
{% for lb in network.load_balancers %}
{% if lb.internet_facing %}
resource "google_compute_http_health_check" "{{ lb.resource_name }}" {
  # Legacy target pools only support HTTP health checks, even for TCP traffic —
  # a known GCP Network LB limitation, not a choice made here.
  name         = "{{ lb.name }}-hc"
  request_path = "{{ lb.health_check_path }}"
  port         = {{ lb.listeners[0].target_port }}
}

resource "google_compute_target_pool" "{{ lb.resource_name }}" {
  name          = "{{ lb.name }}"
  region        = var.region
  health_checks = [google_compute_http_health_check.{{ lb.resource_name }}.self_link]
  instances = [
{% for c in compute %}
{% if c.vm_name in lb.targets %}
    google_compute_instance.{{ c.resource_name }}.self_link,
{% endif %}
{% endfor %}
  ]
}

{% for listener in lb.listeners %}
resource "google_compute_forwarding_rule" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  name       = "{{ lb.name }}-{{ listener.listener_port }}"
  region     = var.region
  port_range = "{{ listener.listener_port }}"
  target     = google_compute_target_pool.{{ lb.resource_name }}.self_link
}

{% endfor %}
{% else %}
resource "google_compute_instance_group" "{{ lb.resource_name }}" {
  name = "{{ lb.name }}-ig"
  zone = var.zone
  instances = [
{% for c in compute %}
{% if c.vm_name in lb.targets %}
    google_compute_instance.{{ c.resource_name }}.self_link,
{% endif %}
{% endfor %}
  ]
}

resource "google_compute_health_check" "{{ lb.resource_name }}" {
  name = "{{ lb.name }}-hc"
  tcp_health_check {
    port = {{ lb.listeners[0].target_port }}
  }
}

resource "google_compute_region_backend_service" "{{ lb.resource_name }}" {
  name                  = "{{ lb.name }}"
  region                = var.region
  protocol              = "TCP"
  load_balancing_scheme = "INTERNAL"
  health_checks         = [google_compute_health_check.{{ lb.resource_name }}.self_link]

  backend {
    group = google_compute_instance_group.{{ lb.resource_name }}.self_link
  }
}

{% for listener in lb.listeners %}
resource "google_compute_forwarding_rule" "{{ lb.resource_name }}_{{ listener.listener_port }}" {
  name                  = "{{ lb.name }}-{{ listener.listener_port }}"
  region                = var.region
  load_balancing_scheme = "INTERNAL"
  network               = google_compute_network.main.id
  subnetwork            = google_compute_subnetwork.{{ (network.subnets | selectattr("tier", "equalto", lb.subnet_tier) | list | first).resource_name }}.id
  backend_service       = google_compute_region_backend_service.{{ lb.resource_name }}.self_link
  ports                 = ["{{ listener.listener_port }}"]
}

{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
