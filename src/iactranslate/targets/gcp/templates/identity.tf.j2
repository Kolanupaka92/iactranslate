{% if identity_roles %}
# Generated by IaCTranslate — workload identity.
#
# One service account per tier, with NO IAM bindings. Grant roles explicitly:
#
#   resource "google_project_iam_member" "app_reads_bucket" {
#     project = var.gcp_project
#     role    = "roles/storage.objectViewer"
#     member  = "serviceAccount:${google_service_account.app.email}"
#   }
{% for tier in identity_roles %}

resource "google_service_account" "{{ tier }}" {
  # account_id is RFC1035-ish and capped at 30 characters, so it is built from
  # the tier rather than the project name, which can be long.
  account_id   = "${var.project_name}-{{ tier }}"
  display_name = "{{ tier }} tier ({{ project }})"
}
{% endfor %}
{% endif %}
