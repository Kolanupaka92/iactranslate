{% if identity_roles %}
# Generated by IaCTranslate — workload identity.
#
# One service account per tier, with NO IAM bindings. Grant roles explicitly:
#
#   resource "google_project_iam_member" "app_reads_bucket" {
#     project = var.gcp_project
#     role    = "roles/storage.objectViewer"
#     member  = "serviceAccount:${google_service_account.app.email}"
#   }
{% for tier in identity_roles %}

resource "google_service_account" "{{ tier }}" {
  # Google allows 6 to 30 characters. A longer name is shortened, with a hash so
  # two long names that start alike stay different.
{% set room = 29 - tier|length %}
  account_id   = length(var.project_name) > {{ room }} ? "${trimsuffix(substr(var.project_name, 0, {{ room - 5 }}), "-")}-${substr(md5(var.project_name), 0, 4)}-{{ tier }}" : {% if tier|length < 4 %}length(var.project_name) < 2 ? "${var.project_name}-{{ tier }}-sa" : {% endif %}"${var.project_name}-{{ tier }}"
  display_name = "{{ tier }} tier ({{ project }})"
}
{% endfor %}
{% endif %}
