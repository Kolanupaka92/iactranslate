# Generated by IaCTranslate — Compute Engine instances, one resource over a
# per-VM map (the `for_each` layout, ADR 0073).
#
# Every machine is a row in `local.vms`; the resource below is written once.
# Keys are the classic layout's labels, so `google_compute_instance.vm["app01"]`
# is the classic `google_compute_instance.app01`.

locals {
  vms = {
{% for c in compute %}
    "{{ c.resource_name }}" = {
      slug         = "{{ vm_slug[c.vm_name] }}"
      machine_type = "{{ c.instance_type }}"
      network_tag  = "{{ c.security_group }}"
      image        = "{{ image_refs[c.image_key].image }}"
      root_gib     = {{ c.root_volume_gib }}
      subnet_id    = google_compute_subnetwork.{{ subnet_of[c.vm_name] }}.id
      external_ip  = {{ "true" if (c.subnet_tier == SubnetTier.PUBLIC and c.vm_name not in fronted_vm_names) else "false" }}
{% if identity_roles %}
      sa_email     = google_service_account.{{ c.tier.value }}.email
{% endif %}
      tier         = "{{ c.tier.value }}"
      environment  = "{{ c.environment.value }}"
    }
{% endfor %}
  }
}

resource "google_compute_instance" "vm" {
  for_each = local.vms

{% if identity_roles %}
  service_account {
    email  = each.value.sa_email
    # Scopes are legacy; cloud-platform defers the decision to IAM,
    # which is where the service account's (currently empty) roles live.
    scopes = ["cloud-platform"]
  }
{% endif %}
  name         = each.value.slug
  machine_type = each.value.machine_type
  zone         = var.zone
  tags         = [each.value.network_tag]

  boot_disk {
    initialize_params {
      image = each.value.image
      size  = each.value.root_gib
      type  = "pd-balanced"
    }
{% if kms_key_id %}
    # Persistent disks are always encrypted at rest with a Google-managed key;
    # this substitutes a customer-managed key from Cloud KMS.
    kms_key_self_link = "{{ kms_key_id }}"
{% endif %}
  }

  network_interface {
    subnetwork = each.value.subnet_id
    dynamic "access_config" {
      # Ephemeral external IP, only for a public instance not behind an LB.
      for_each = each.value.external_ip ? [1] : []
      content {}
    }
  }

  labels = {
    tier        = each.value.tier
    environment = each.value.environment
    source_vm   = each.value.slug
  }
}
